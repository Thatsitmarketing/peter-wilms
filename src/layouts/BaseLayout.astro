---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { company } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${company.name} – Ihr Spezialist für Brücken- und Bauwerksinstandsetzung in NRW. Betoninstandsetzung, Rissverpressung, Korrosionsschutz und mehr.`,
} = Astro.props;
---

<!doctype html>
<html lang="de" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#16212c" />
    <script is:inline>
      // Kennzeichnet früh, dass JS verfügbar ist (steuert Reveal-Fallback in CSS)
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 200;
    background: var(--color-ink);
    color: #fff;
    padding: 0.6rem 1rem;
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .skip-link:focus {
    top: 0;
  }
</style>
