---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/sections/Contact.astro';
import Team from '../components/sections/about/Team.astro';
import JobsCta from '../components/sections/JobsCta.astro';
import { company } from '../data/site';

const { contact, address } = company;
---

<BaseLayout
  title="Kontakt – Peter Willms Bauunternehmung GmbH"
  description="Kontakt zur Peter Willms Bauunternehmung GmbH. Direkte Ansprechpartner für Brücken- und Bauwerksinstandsetzung in ganz NRW."
>
  <!-- Hero -->
  <section class="kontakt-hero photo-placeholder" aria-labelledby="kontakt-hero-title">
    <div class="kontakt-hero__overlay" aria-hidden="true"></div>
    <div class="photo-placeholder__tag">
      <span>Bild-Platzhalter: Brückenbauwerk (Vollbild-Hintergrund)</span>
    </div>

    <div class="container kontakt-hero__content">
      <p class="kontakt-hero__kicker" data-reveal>Kontakt</p>
      <h1 class="kontakt-hero__title" id="kontakt-hero-title" data-reveal style="--reveal-delay: 0.08s">
        Kontakt zur Peter Willms<br />Bauunternehmung GmbH
      </h1>
      <p class="kontakt-hero__subline" data-reveal style="--reveal-delay: 0.16s">
        Wir sind für Ihre Fragen und Projekte da. Erreichen Sie uns schnell und unkompliziert.
      </p>
    </div>
  </section>

  <!-- Direkte Kontaktwege (Erreichbarkeit) -->
  <section class="section direct" aria-labelledby="direct-title">
    <div class="container direct__grid">
      <div class="direct__head">
        <span class="section__kicker" data-reveal>Erreichbar</span>
        <h2 class="section__title" id="direct-title" data-reveal style="--reveal-delay: 0.06s">
          Direkte Kontaktwege zu uns
        </h2>
        <p class="section__intro" data-reveal style="--reveal-delay: 0.12s">
          Alle wichtigen Nummern und Adressen auf einen Blick. Wählen Sie den Weg, der für Sie passt.
        </p>
      </div>

      <ul class="direct__list">
        <li class="direct-card" data-reveal>
          <div class="direct-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.86 19.86 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <h3>Rufen Sie uns an</h3>
            <p>Montag bis Freitag von 8 bis 17 Uhr erreichbar. Wir nehmen uns Zeit für Ihre Fragen.</p>
            <a href={`tel:${contact.phoneCentral.replace(/\s/g, '')}`}>{contact.phoneCentralDisplay}</a>
          </div>
        </li>

        <li class="direct-card" data-reveal style="--reveal-delay: 0.06s">
          <div class="direct-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
          </div>
          <div>
            <h3>Schreiben Sie uns eine Nachricht</h3>
            <p>Ihre Anfrage erreicht uns zuverlässig. Wir antworten innerhalb von 24 Stunden.</p>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </div>
        </li>

        <li class="direct-card" data-reveal style="--reveal-delay: 0.12s">
          <div class="direct-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <h3>Besuchen Sie uns vor Ort</h3>
            <p>{address.street}, {address.zip} {address.city}. Gerne zeigen wir Ihnen unsere Räume.</p>
          </div>
        </li>

        <li class="direct-card" data-reveal style="--reveal-delay: 0.18s">
          <div class="direct-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M12 18h.01"/></svg>
          </div>
          <div>
            <h3>Mobil für Ihre Projekte</h3>
            <p>Unsere Bauleiter sind vor Ort für Sie da. Direkter Kontakt zu den Verantwortlichen.</p>
            <a href={`tel:${contact.mobile.replace(/\s/g, '')}`}>{contact.mobileDisplay}</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Kontaktblock mit Formular -->
  <Contact />

  <!-- Ansprechpartner (übernommen aus Über uns) -->
  <Team />

  <!-- Karriere-CTA -->
  <JobsCta />
</BaseLayout>

<style>
  .kontakt-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(34rem, 68svh);
    color: #fff;
    padding-block: clamp(5rem, 12vw, 8rem) clamp(3rem, 7vw, 4.5rem);
    text-align: left;
  }

  .kontakt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.2) 45%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .kontakt-hero__content {
    position: relative;
    z-index: 2;
  }

  .kontakt-hero__kicker {
    display: inline-block;
    background: var(--color-red);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.35rem 0.9rem;
    margin: 0 0 1.25rem;
  }

  .kontakt-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.15;
    color: #fff;
    margin: 0 0 1rem;
    max-width: 24ch;
  }

  .kontakt-hero__subline {
    max-width: 60ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.92);
  }

  /* Direkte Kontaktwege */
  .direct__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .direct__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .direct-card {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.25rem;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border: 1px solid var(--color-line);
  }

  .direct-card__icon {
    display: grid;
    place-items: center;
    color: var(--color-red);
  }

  .direct-card h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin: 0 0 0.4rem;
  }

  .direct-card p {
    margin: 0 0 0.5rem;
    color: var(--color-slate);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .direct-card a {
    color: var(--color-red);
    text-decoration: none;
    font-weight: 600;
  }

  .direct-card a:hover {
    text-decoration: underline;
  }

  @media (max-width: 62rem) {
    .direct__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
