---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
import { company } from '../data/site';

const mailto = `mailto:${company.contact.email}?subject=${encodeURIComponent('Initiativbewerbung bei der Peter Willms Bauunternehmung GmbH')}`;

const positions = [
  {
    title: 'Maurer mit Erfahrung',
    kind: 'Vollzeit',
    text: 'Wir suchen Verstärkung in der Region. Facharbeit im Brücken- und Bauwerksinstandsetzungsbau.',
    details: {
      tasks: [
        'Instandsetzungsarbeiten an Brücken- und Betonbauwerken',
        'Reprofilierung und Rissverpressung nach DAfStb-Richtlinie',
        'Zusammenarbeit im festen Kolonnenteam',
      ],
      qualifications: [
        'Abgeschlossene Ausbildung als Maurer/-in oder Beton- und Stahlbetonbauer/-in',
        'Erfahrung im Ingenieurbau von Vorteil',
        'Führerschein Klasse B, idealerweise BE',
      ],
      pay: 'Nach Bau-Tarif zzgl. Zulagen (Details im Gespräch)',
      benefits: [
        'Unbefristete Anstellung in einem etablierten Fachbetrieb',
        'Moderne Ausrüstung und hochwertige Arbeitskleidung',
        'Weiterbildung zum SIVV- bzw. KOR-Schein möglich',
      ],
      start: 'Ab sofort',
      location: 'Ennigerloh-Westkirchen · Einsatzgebiet NRW',
    },
  },
  {
    title: 'Elektrotechniker für moderne Baustellen',
    kind: 'Vollzeit',
    text: 'Elektrische und schaltungstechnische Aufgaben auf modernen Baustellen der Ingenieurbaukunst.',
    details: {
      tasks: [
        'Installation und Instandhaltung baustellenseitiger Elektrik',
        'Betreuung der Verkehrssicherungssysteme nach RSA',
        'Zusammenarbeit mit Bauleitung und Fachpartnern',
      ],
      qualifications: [
        'Abgeschlossene Ausbildung im Elektrohandwerk',
        'Kenntnisse in Nieder-/Mittelspannungstechnik',
        'Selbstständige, strukturierte Arbeitsweise',
      ],
      pay: 'Attraktives Gehalt nach Qualifikation (Details im Gespräch)',
      benefits: [
        '30 Tage Urlaub',
        'Firmenwagen zur beruflichen Nutzung',
        'Weiterbildungsbudget für Zertifizierungen',
      ],
      start: 'Ab sofort',
      location: 'Ennigerloh-Westkirchen · Einsatzgebiet NRW',
    },
  },
  {
    title: 'Projektmanager und kaufmännische Kraft',
    kind: 'Vollzeit',
    text: 'Kaufmännische Steuerung von Projekten und Unterstützung der Bauleitung im Büro.',
    details: {
      tasks: [
        'Angebotserstellung und Kalkulation nach VOB',
        'Auftragsabwicklung und Abrechnung öffentlicher Bauvorhaben',
        'Schnittstelle zwischen Auftraggeber, Bauleitung und Buchhaltung',
      ],
      qualifications: [
        'Kaufmännische Ausbildung oder Studium (Bau-/Wirtschaftsingenieurwesen)',
        'Erfahrung mit VOB und öffentlichen Ausschreibungen wünschenswert',
        'Sicherer Umgang mit MS Office und Bau-Software',
      ],
      pay: 'Leistungsorientierte Vergütung (Details im Gespräch)',
      benefits: [
        'Modernes Büro am Standort Ennigerloh-Westkirchen',
        'Flexible Arbeitszeiten, teilweise mobiles Arbeiten möglich',
        'Kurze Entscheidungswege in einem inhabergeführten Betrieb',
      ],
      start: 'Ab sofort',
      location: 'Ennigerloh-Westkirchen',
    },
  },
];

const values = [
  {
    title: 'Handwerkliches Können',
    text: 'Mitarbeiten, die ihr Handwerk verstehen und aus Freude an der Sache handeln.',
  },
  {
    title: 'Zuverlässigkeit',
    text: 'Termintreue, saubere Ausführung und ein Team, auf das jeder zählen kann.',
  },
  {
    title: 'Lernbereitschaft',
    text: 'Wir fördern Weiterentwicklung und neue Methoden im modernen Ingenieurbau.',
  },
];

const timeline = [
  { tag: 'Tag 1', text: 'Bewerbung einreichen und erste Rückmeldung durch unser Team.' },
  { tag: 'Tag 3', text: 'Telefonisches Vorabgespräch mit der Personalabteilung.' },
  { tag: 'Tag 7', text: 'Persönliches Treffen mit den Verantwortlichen vor Ort.' },
  { tag: 'Tag 14', text: 'Praktischer Test oder Arbeitsprobe je nach Position.' },
];
---

<BaseLayout
  title="Jobs – Peter Willms Bauunternehmung GmbH"
  description="Werde Teil unseres Teams bei der Peter Willms Bauunternehmung GmbH. Offene Stellen für Handwerker, Bauleiter und kaufmännische Fachkräfte in NRW."
>
  <!-- Hero -->
  <section class="jobs-hero" aria-labelledby="jobs-hero-title">
    <div class="container jobs-hero__grid">
      <div class="jobs-hero__content" data-reveal>
        <p class="jobs-hero__kicker">Karriere</p>
        <h1 class="jobs-hero__title" id="jobs-hero-title">Bauen Sie Ihre Karriere mit uns auf</h1>
        <p class="jobs-hero__text">
          Bei Peter Willms Bauunternehmung arbeiten Sie an Projekten, die Ihren Anlauf verdienen.
          Wir suchen tatkräftige Menschen, die Verantwortung tragen wollen.
        </p>
        <div class="jobs-hero__actions">
          <a class="btn btn--red" href="#offene-positionen">Bewerben</a>
          <a class="btn btn--white" href="#einblicke">Einblicke</a>
        </div>
      </div>
      <div class="jobs-hero__media photo-placeholder" role="img" aria-label="Team auf der Baustelle">
        <div class="photo-placeholder__tag"><span>Foto: Team auf der Baustelle</span></div>
      </div>
    </div>
  </section>

  <!-- Offene Positionen -->
  <section class="section section--soft positions" id="offene-positionen" aria-labelledby="positions-title">
    <div class="container">
      <div class="positions__head">
        <span class="section__kicker" data-reveal>Suchen</span>
        <h2 class="section__title" id="positions-title" data-reveal style="--reveal-delay: 0.06s">
          Polier und Bauleiter gesucht
        </h2>
        <p class="section__intro" data-reveal style="--reveal-delay: 0.12s">
          Verstärkung für Baustellen und Teams
        </p>
      </div>

      <ul class="positions__grid">
        {positions.map((position, index) => (
          <li class="position-card" data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
            <div class="position-card__flip" data-flip-card>
              <!-- Vorderseite -->
              <div class="position-card__face position-card__face--front">
                <div class="position-card__media photo-placeholder" aria-hidden="true">
                  <div class="photo-placeholder__tag"><span>Foto: {position.title}</span></div>
                </div>
                <div class="position-card__body">
                  <p class="position-card__kind">{position.kind}</p>
                  <h3 class="position-card__title">{position.title}</h3>
                  <p class="position-card__text">{position.text}</p>
                  <div class="position-card__actions">
                    <a class="btn btn--red btn--small" href={mailto}>Bewerben</a>
                    <button type="button" class="btn btn--outline btn--small" data-flip-open aria-expanded="false">
                      Details
                    </button>
                  </div>
                </div>
              </div>

              <!-- Rückseite -->
              <div class="position-card__face position-card__face--back" aria-hidden="true">
                <div class="position-card__body position-card__body--back">
                  <div class="position-card__back-scroll">
                    <div class="position-card__back-head">
                      <div>
                        <p class="position-card__kind">{position.kind}</p>
                        <h3 class="position-card__title">{position.title}</h3>
                      </div>
                      <button type="button" class="position-card__close" data-flip-close aria-label="Details schließen">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M18 6 6 18M6 6l12 12" />
                        </svg>
                      </button>
                    </div>

                    <dl class="position-card__meta">
                      <div>
                        <dt>Start</dt>
                        <dd>{position.details.start}</dd>
                      </div>
                      <div>
                        <dt>Einsatzort</dt>
                        <dd>{position.details.location}</dd>
                      </div>
                      <div>
                        <dt>Vergütung</dt>
                        <dd>{position.details.pay}</dd>
                      </div>
                    </dl>

                    <div class="position-card__section">
                      <h4>Ihre Aufgaben</h4>
                      <ul>
                        {position.details.tasks.map((task) => <li>{task}</li>)}
                      </ul>
                    </div>

                    <div class="position-card__section">
                      <h4>Qualifikationen</h4>
                      <ul>
                        {position.details.qualifications.map((qual) => <li>{qual}</li>)}
                      </ul>
                    </div>

                    <div class="position-card__section">
                      <h4>Benefits</h4>
                      <ul>
                        {position.details.benefits.map((benefit) => <li>{benefit}</li>)}
                      </ul>
                    </div>
                  </div>

                  <div class="position-card__back-footer">
                    <a class="btn btn--red btn--small position-card__apply" href={mailto}>Jetzt bewerben</a>
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Werte -->
  <section class="section section--dark values" aria-labelledby="values-title">
    <div class="container">
      <div class="values__head">
        <span class="section__kicker" data-reveal>Kultur</span>
        <h2 class="section__title" id="values-title" data-reveal style="--reveal-delay: 0.06s">
          Das bringen Sie bei uns mit
        </h2>
        <p class="section__intro" data-reveal style="--reveal-delay: 0.12s">
          Wir suchen Menschen, die ihre Handwerk verstehen und ihre Arbeit ernst nehmen.
        </p>
      </div>

      <ul class="values__grid">
        {values.map((value, index) => (
          <li class="value-card" data-reveal style={`--reveal-delay: ${index * 0.08}s`}>
            <h3>{value.title}</h3>
            <p>{value.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Ihr Weg zu Peter Willms -->
  <section class="section section--soft roadmap" aria-labelledby="roadmap-title">
    <div class="container roadmap__grid">
      <div class="roadmap__head">
        <span class="section__kicker" data-reveal>Prozess</span>
        <h2 class="section__title" id="roadmap-title" data-reveal style="--reveal-delay: 0.06s">
          Ihr Weg zu Peter Willms
        </h2>
      </div>

      <ol class="roadmap__list">
        {timeline.map((step, index) => (
          <li class="roadmap-step" data-reveal style={`--reveal-delay: ${index * 0.06}s`}>
            <span class="roadmap-step__tag">{step.tag}</span>
            <p class="roadmap-step__text">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Video-Sektion -->
  <section class="section jobs-video" id="einblicke" aria-labelledby="jobs-video-title">
    <div class="container">
      <div class="jobs-video__frame" data-reveal>
        <button type="button" class="jobs-video__play" aria-label="Video abspielen (Platzhalter)">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5z" />
          </svg>
        </button>
        <h2 class="jobs-video__title" id="jobs-video-title">Sehen Sie, wie wir arbeiten</h2>
        <p class="jobs-video__meta">Einblick in unsere Baustellen und Büros</p>
      </div>
    </div>
  </section>

  <Faq />

  <!-- Initiativbewerbung -->
  <section class="section section--dark init" aria-labelledby="init-title">
    <div class="container init__grid">
      <div class="init__head" data-reveal>
        <span class="section__kicker">Bewerbung</span>
        <h2 class="section__title" id="init-title">Initiativbewerbung</h2>
        <p class="section__intro">
          Keine passende Stelle dabei? Schreiben Sie uns trotzdem – wir freuen uns über Ihre Nachricht.
        </p>
      </div>

      <form class="init__form" data-reveal="right" data-init-form novalidate>
        <div class="form-field">
          <label for="if-name">Name *</label>
          <input type="text" id="if-name" name="name" required autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="if-email">E-Mail *</label>
          <input type="email" id="if-email" name="email" required autocomplete="email" />
        </div>
        <div class="form-field">
          <label for="if-message">Nachricht</label>
          <textarea id="if-message" name="message" rows="5"></textarea>
        </div>
        <div class="form-field form-field--consent">
          <label>
            <input type="checkbox" name="privacy" required />
            <span>
              Ich habe die <a href="/datenschutz">Datenschutzerklärung</a> zur Kenntnis genommen.
            </span>
          </label>
        </div>
        <a class="btn btn--red" href={mailto}>Senden</a>
      </form>
    </div>
  </section>

  <Contact />
</BaseLayout>

<style>
  /* Hero */
  .jobs-hero {
    padding-block: clamp(4rem, 8vw, 6rem);
  }

  .jobs-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .jobs-hero__kicker {
    display: inline-block;
    background: var(--color-red);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.35rem 0.9rem;
    margin: 0 0 1.25rem;
  }

  .jobs-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.15;
    margin: 0 0 1.25rem;
    max-width: 22ch;
  }

  .jobs-hero__text {
    max-width: 52ch;
    color: var(--color-slate);
    margin: 0 0 2rem;
  }

  .jobs-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .jobs-hero__media {
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 62rem) {
    .jobs-hero__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Positions */
  .positions__head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .positions__head .section__intro {
    margin-inline: auto;
  }

  .positions__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .position-card {
    perspective: 1600px;
    display: block;
  }

  /* Flip-Container – hält Vorder- und Rückseite, dreht sich um Y-Achse.
     min-height ist so gewählt, dass die Vorderseite (Bild + Kicker + Titel +
     Kurztext + Aktionen) vollständig ohne Abschneiden dargestellt wird. Die
     ausführliche Rückseite scrollt innerhalb der Karte. */
  .position-card__flip {
    position: relative;
    width: 100%;
    min-height: 26rem;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease-out);
  }

  .position-card__flip.is-flipped {
    transform: rotateY(180deg);
  }

  .position-card__face {
    position: absolute;
    inset: 0;
    background: #fff;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .position-card__face--back {
    transform: rotateY(180deg);
  }

  /* Wenn geflippt, die Rückseite anfassbar machen und die Vorderseite deaktivieren */
  .position-card__flip.is-flipped .position-card__face--front {
    pointer-events: none;
  }

  .position-card__flip.is-flipped .position-card__face--back {
    pointer-events: auto;
  }

  .position-card__media {
    height: 11rem;
    flex-shrink: 0;
  }

  .position-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  /* Rückseite: scrollt intern, Aktionsleiste bleibt sichtbar am unteren Rand. */
  .position-card__body--back {
    padding: 0;
    gap: 0;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .position-card__back-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1.25rem 1.5rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .position-card__back-footer {
    padding: 0.9rem 1.5rem 1rem;
    border-top: 1px solid var(--color-line);
    background: #fff;
    display: flex;
    justify-content: flex-start;
  }

  .position-card__back-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .position-card__close {
    background: none;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .position-card__close:hover {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
  }

  .position-card__kind {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    color: var(--color-red);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .position-card__title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    line-height: 1.2;
    margin: 0 0 0.6rem;
  }

  .position-card__text {
    margin: 0 0 1rem;
    color: var(--color-slate);
    font-size: 0.9rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .position-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  /* Kompakte Buttons für die Karten-Aktionen (kleinere Padding-Fassung der
     globalen .btn-Klassen; ohne Hover-Translate der Präfixmarke, damit die
     Karten stabil bleiben). */
  .position-card__actions .btn {
    padding: 0.55rem 0.9rem;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    box-shadow: none;
    flex: 1 1 auto;
  }

  .position-card__actions .btn--outline {
    padding: calc(0.55rem - 2px) calc(0.9rem - 2px);
  }

  .position-card__actions .btn::before {
    display: none;
  }

  .position-card__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0.75rem 1rem;
    background: var(--color-bg-soft);
    border-left: 3px solid var(--color-red);
  }

  .position-card__meta dt {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-slate);
    margin: 0 0 0.15rem;
  }

  .position-card__meta dd {
    margin: 0;
    color: var(--color-ink);
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .position-card__section h4 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-ink);
    margin: 0 0 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .position-card__section ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .position-card__section li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.88rem;
    color: var(--color-slate);
    line-height: 1.5;
  }

  .position-card__section li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--color-red);
    border-radius: 50%;
  }

  .position-card__apply {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .position-card__flip {
      transition: none;
    }
  }

  /* Values */
  .values .section__title {
    color: #fff;
  }

  .values__head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .values__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .value-card {
    padding: 1.5rem;
    border-top: 3px solid var(--color-red);
  }

  .value-card h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    margin: 0 0 0.6rem;
    color: #fff;
  }

  .value-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
  }

  /* Roadmap */
  .roadmap__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .roadmap__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .roadmap-step {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .roadmap-step__tag {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-red);
  }

  .roadmap-step__text {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.6;
  }

  @media (max-width: 62rem) {
    .roadmap__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Jobs Video */
  .jobs-video__frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 60vh;
    background:
      radial-gradient(40rem 18rem at 50% 60%, rgba(255, 255, 255, 0.05), transparent 70%),
      var(--color-dark);
