<script>
  /**
   * Job-Karten: Klick auf "Details" flippt die Karte, Klick auf das X (oder
   * Escape) flippt zurück. Beim Flip wird aria-hidden auf die jeweilige
   * Seite gesetzt, damit Screenreader den passenden Inhalt lesen.
   */
  const cards = document.querySelectorAll<HTMLElement>('[data-flip-card]');

  cards.forEach((card) => {
    const openBtn = card.querySelector<HTMLButtonElement>('[data-flip-open]');
    const closeBtn = card.querySelector<HTMLButtonElement>('[data-flip-close]');
    const front = card.querySelector<HTMLElement>('.position-card__face--front');
    const back = card.querySelector<HTMLElement>('.position-card__face--back');

    const setState = (flipped: boolean) => {
      card.classList.toggle('is-flipped', flipped);
      openBtn?.setAttribute('aria-expanded', String(flipped));
      front?.setAttribute('aria-hidden', String(flipped));
      back?.setAttribute('aria-hidden', String(!flipped));
    };

    openBtn?.addEventListener('click', () => setState(true));
    closeBtn?.addEventListener('click', () => setState(false));

    card.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && card.classList.contains('is-flipped')) {
        setState(false);
        closeBtn?.focus();
      }
    });
  });
</script>
