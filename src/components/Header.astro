---
import { brandLogo, navigation } from '../data/site';

interface Props {
  /** true = liegt transparent über dem Hero und wird beim Scrollen weiß */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
/** Trailing Slash ignorieren, damit /ueber-uns und /ueber-uns/ gleich behandelt werden */
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class:list={['header', { 'header--transparent': transparent }]} data-header>
  <div class="container header__inner">
    <a href="/" class="header__brand" aria-label="Peter Willms Bauunternehmung – Startseite">
      <!-- Zwei Fassungen: weiß über dem Hero, farbig auf weißem Header -->
      <img
        class="header__logo header__logo--color"
        src={brandLogo.color}
        alt={brandLogo.alt}
        width="512"
        height="400"
      />
      <img
        class="header__logo header__logo--white"
        src={brandLogo.white}
        alt=""
        aria-hidden="true"
        width="1024"
        height="800"
      />
    </a>

    <nav class="header__nav" aria-label="Hauptnavigation">
      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="main-menu"
        data-nav-toggle
      >
        <span class="sr-only">Menü öffnen</span>
        <span class="header__toggle-bar" aria-hidden="true"></span>
      </button>
      <ul class="header__menu" id="main-menu" data-nav-menu>
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={{ 'is-active': item.href === pathname }}
              aria-current={item.href === pathname ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .header.is-scrolled {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
  }

  /* Transparent über dem Hero (Startseite) */
  .header--transparent {
    position: fixed;
    inset-inline: 0;
    background: transparent;
  }

  .header--transparent.is-scrolled {
    background: #fff;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5.25rem;
    position: relative;
  }

  /* Beide Logofassungen liegen übereinander – kein Layout-Sprung beim Wechsel */
  .header__brand {
    display: grid;
    align-items: center;
    justify-items: start;
    text-decoration: none;
    color: var(--color-ink);
  }

  .header__logo {
    grid-area: 1 / 1;
    height: clamp(2.6rem, 4.5vw, 3.4rem);
    width: auto;
    transition: opacity 0.3s ease;
  }

  .header__logo--white {
    opacity: 0;
  }

  /* Nav mittig wie in der Referenz */
  .header__menu {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__menu a {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .header__menu a:hover,
  .header__menu a.is-active {
    color: var(--color-red);
  }

  /* Über dem Hero: weiße Schrift und weißes Logo */
  .header--transparent:not(.is-scrolled) .header__brand,
  .header--transparent:not(.is-scrolled) .header__menu a {
    color: #fff;
  }

  .header--transparent:not(.is-scrolled) .header__logo--color {
    opacity: 0;
  }

  .header--transparent:not(.is-scrolled) .header__logo--white {
    opacity: 1;
  }

  .header--transparent:not(.is-scrolled) .header__menu a:hover,
  .header--transparent:not(.is-scrolled) .header__menu a.is-active {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-red);
  }

  .header__toggle {
    display: none;
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line);
    background: #fff;
    cursor: pointer;
  }

  .header__toggle-bar,
  .header__toggle-bar::before,
  .header__toggle-bar::after {
    position: absolute;
    left: 50%;
    width: 1.25rem;
    height: 2px;
    background: var(--color-ink);
    transform: translateX(-50%);
    transition: transform 0.25s var(--ease-out), opacity 0.2s ease;
    content: '';
  }

  .header__toggle-bar {
    top: 50%;
  }

  .header__toggle-bar::before {
    top: -6px;
  }

  .header__toggle-bar::after {
    top: 6px;
  }

  .header__toggle[aria-expanded='true'] .header__toggle-bar {
    background: transparent;
  }

  .header__toggle[aria-expanded='true'] .header__toggle-bar::before {
    transform: translateX(-50%) translateY(6px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] .header__toggle-bar::after {
    transform: translateX(-50%) translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 48rem) {
    .header__toggle {
      display: block;
    }

    .header__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      transform: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.14);
      padding: 0.5rem 1.5rem 1.25rem;
      display: none;
    }

    .header__menu.is-open {
      display: flex;
    }

    .header__menu li {
      border-bottom: 1px solid var(--color-line);
    }

    .header__menu li:last-child {
      border-bottom: none;
    }

    .header__menu a {
      display: block;
      padding: 0.9rem 0;
      color: var(--color-ink) !important;
      text-decoration: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('is-open', !open);
    });

    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('is-open');
      }
    });
  }
</script>
