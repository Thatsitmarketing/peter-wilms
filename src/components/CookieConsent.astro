---
/**
 * Cookie-Consent-UI: Banner (Erstbesuch) + Einstellungs-Dialog (jederzeit über
 * Footer-Link „Cookie-Einstellungen" erreichbar). Die Logik liegt vollständig
 * in src/scripts/consent.ts – diese Komponente ist nur die Oberfläche und kann
 * zusammen mit dem Skript später gegen eine agenturweite Lösung getauscht werden.
 */

const categories = [
  {
    id: 'necessary',
    label: 'Notwendig',
    locked: true,
    description:
      'Erforderlich für den Betrieb der Website, z. B. das Speichern Ihrer Cookie-Einstellungen. Kann nicht deaktiviert werden.',
  },
  {
    id: 'functional',
    label: 'Darstellung & Funktion',
    locked: false,
    description:
      'Ermöglicht das Nachladen externer Inhalte wie Kartendienste (z. B. Google Maps). Ohne Einwilligung werden diese Inhalte nicht geladen.',
  },
  {
    id: 'statistics',
    label: 'Statistik',
    locked: false,
    description:
      'Hilft uns zu verstehen, wie die Website genutzt wird (z. B. anonymisierte Reichweitenmessung). Derzeit sind keine Statistik-Dienste eingebunden.',
  },
  {
    id: 'marketing',
    label: 'Marketing',
    locked: false,
    description:
      'Dienste zur Erfolgsmessung von Werbung. Derzeit sind keine Marketing-Dienste eingebunden.',
  },
] as const;
---

<!-- Banner beim Erstbesuch -->
<div class="consent-banner" data-consent-banner hidden role="region" aria-label="Cookie-Hinweis">
  <div class="consent-banner__inner">
    <div>
      <p class="consent-banner__title">Datenschutz-Einstellungen</p>
      <p class="consent-banner__text">
        Wir verwenden nur technisch notwendige Cookies. Externe Inhalte (z.&nbsp;B.
        Kartendienste) werden erst nach Ihrer Einwilligung geladen. Details finden Sie in
        unserer <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>
    </div>
    <div class="consent-banner__actions">
      <button type="button" class="btn btn--primary" data-consent-accept-all>
        Alle akzeptieren
      </button>
      <button type="button" class="btn btn--ghost-dark" data-consent-necessary-only>
        Nur notwendige
      </button>
      <button type="button" class="consent-banner__settings" data-consent-show-settings>
        Einstellungen anpassen
      </button>
    </div>
  </div>
</div>

<!-- Einstellungs-Dialog -->
<dialog class="consent-dialog" data-consent-dialog aria-labelledby="consent-dialog-title">
  <form method="dialog" class="consent-dialog__inner" data-consent-form>
    <h2 class="consent-dialog__title" id="consent-dialog-title">Cookie-Einstellungen</h2>
    <p class="consent-dialog__intro">
      Legen Sie fest, welche Kategorien Sie zulassen möchten. Ihre Auswahl können Sie
      jederzeit über den Link „Cookie-Einstellungen" im Footer ändern.
    </p>

    <div class="consent-dialog__categories">
      {categories.map((cat) => (
        <div class="consent-category">
          <div class="consent-category__head">
            <span class="consent-category__label" id={`consent-label-${cat.id}`}>{cat.label}</span>
            <label class="consent-switch">
              <input
                type="checkbox"
                name={cat.id}
                checked={cat.locked}
                disabled={cat.locked}
                aria-labelledby={`consent-label-${cat.id}`}
              />
              <span class="consent-switch__track" aria-hidden="true"></span>
            </label>
          </div>
          <p class="consent-category__description">{cat.description}</p>
        </div>
      ))}
    </div>

    <div class="consent-dialog__actions">
      <button type="button" class="btn btn--primary" data-consent-accept-all>
        Alle akzeptieren
      </button>
      <button type="submit" class="btn btn--ghost-dark" value="save">
        Auswahl speichern
      </button>
    </div>

    <p class="consent-dialog__links">
      <a href="/datenschutz">Datenschutzerklärung</a>
      <a href="/impressum">Impressum</a>
    </p>
  </form>
</dialog>

<style>
  .consent-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 150;
    background: #fff;
    border-top: 3px solid var(--color-accent);
    box-shadow: 0 -12px 40px rgba(22, 33, 44, 0.18);
    animation: consent-slide-up 0.45s var(--ease-out);
  }

  @keyframes consent-slide-up {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  .consent-banner__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .consent-banner__title {
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .consent-banner__text {
    margin: 0;
    max-width: 56ch;
    font-size: 0.92rem;
    color: var(--color-slate);
  }

  .consent-banner__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .consent-banner__settings {
    background: none;
    border: none;
    font: inherit;
    font-size: 0.9rem;
    color: var(--color-slate);
    text-decoration: underline;
    cursor: pointer;
    padding: 0.5rem 0.25rem;
  }

  .consent-banner__settings:hover {
    color: var(--color-ink);
  }

  .consent-dialog {
    border: none;
    border-radius: var(--radius);
    padding: 0;
    max-width: 34rem;
    width: calc(100vw - 2.5rem);
    box-shadow: 0 24px 80px rgba(22, 33, 44, 0.35);
  }

  .consent-dialog::backdrop {
    background: rgba(22, 33, 44, 0.55);
    backdrop-filter: blur(2px);
  }

  .consent-dialog__inner {
    padding: 2rem 1.75rem;
    max-height: min(85vh, 44rem);
    overflow-y: auto;
  }

  .consent-dialog__title {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .consent-dialog__intro {
    font-size: 0.92rem;
    color: var(--color-slate);
  }

  .consent-dialog__categories {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .consent-category {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
  }

  .consent-category__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .consent-category__label {
    font-weight: 600;
  }

  .consent-category__description {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--color-slate);
  }

  /* Schalter */
  .consent-switch {
    position: relative;
    display: inline-block;
    width: 2.9rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  .consent-switch input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }

  .consent-switch input:disabled {
    cursor: not-allowed;
  }

  .consent-switch__track {
    position: absolute;
    inset: 0;
    background: #c4ccd4;
    border-radius: 999px;
    transition: background-color 0.2s ease;
    pointer-events: none;
  }

  .consent-switch__track::after {
    content: '';
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: 1.2rem;
    height: 1.2rem;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s var(--ease-out);
  }

  .consent-switch input:checked + .consent-switch__track {
    background: var(--color-accent);
  }

  .consent-switch input:disabled + .consent-switch__track {
    background: var(--color-ink-soft);
    opacity: 0.5;
  }

  .consent-switch input:checked + .consent-switch__track::after {
    transform: translateX(1.3rem);
  }

  .consent-switch input:focus-visible + .consent-switch__track {
    outline: 2px solid var(--color-accent-dark);
    outline-offset: 2px;
  }

  .consent-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .consent-dialog__links {
    margin: 1.25rem 0 0;
    display: flex;
    gap: 1.25rem;
    font-size: 0.85rem;
  }
</style>

<script>
  import { consentManager } from '../scripts/consent';

  const banner = document.querySelector<HTMLElement>('[data-consent-banner]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-consent-dialog]');
  const form = document.querySelector<HTMLFormElement>('[data-consent-form]');

  function hideBanner() {
    banner?.setAttribute('hidden', '');
  }

  function syncFormWithState() {
    if (!form) return;
    const state = consentManager.getConsent();
    (['functional', 'statistics', 'marketing'] as const).forEach((cat) => {
      const input = form.elements.namedItem(cat) as HTMLInputElement | null;
      if (input) input.checked = state[cat];
    });
  }

  function openDialog() {
    if (!dialog) return;
    syncFormWithState();
    dialog.showModal();
  }

  // Banner nur zeigen, wenn noch keine Entscheidung vorliegt
  if (!consentManager.hasDecided()) {
    banner?.removeAttribute('hidden');
  }

  // „Alle akzeptieren" (Banner und Dialog)
  document.querySelectorAll('[data-consent-accept-all]').forEach((btn) => {
    btn.addEventListener('click', () => {
      consentManager.acceptAll();
      hideBanner();
      dialog?.close();
    });
  });

  // „Nur notwendige"
  document.querySelectorAll('[data-consent-necessary-only]').forEach((btn) => {
    btn.addEventListener('click', () => {
      consentManager.acceptNecessaryOnly();
      hideBanner();
    });
  });

  // „Einstellungen anpassen" im Banner
  document.querySelectorAll('[data-consent-show-settings]').forEach((btn) => {
    btn.addEventListener('click', openDialog);
  });

  // Öffnen über die Consent-API (z. B. Footer-Link)
  document.addEventListener('consent:open', openDialog);

  // „Auswahl speichern" – Dialog-Submit
  form?.addEventListener('submit', () => {
    consentManager.save({
      functional: (form.elements.namedItem('functional') as HTMLInputElement).checked,
      statistics: (form.elements.namedItem('statistics') as HTMLInputElement).checked,
      marketing: (form.elements.namedItem('marketing') as HTMLInputElement).checked,
    });
    hideBanner();
  });
</script>
