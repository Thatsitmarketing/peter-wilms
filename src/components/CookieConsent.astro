---
/**
 * Zentrale Consent-UI:
 *   1. Fest sichtbares Cookie-Widget unten rechts (öffnet den Dialog).
 *   2. Zentrierter Consent-Dialog nach klassischem Vorbild:
 *      Titel "Cookie-Einstellungen", Beschreibungstext, für jede Kategorie
 *      eine Karte (Titel, Beschreibung, Toggle, Details-Klappe), unten fest
 *      die drei Aktionen "Alle ablehnen", "Alle akzeptieren",
 *      "Auswahl speichern".
 *
 * Optionale Dienste werden ausschließlich in der Service-Registry
 * (`src/scripts/consent/registry.ts`) hinzugefügt und aktiviert. Für
 * Kategorien ohne aktiven Dienst wird das transparent im Detailbereich
 * ausgewiesen ("Aktuell sind in dieser Kategorie keine Dienste eingebunden.").
 */
import CookiePrivacyIcon from './CookiePrivacyIcon.astro';
---

<!-- Rotes eckiges Cookie-Widget (immer sichtbar, rechts unten) -->
<button
  type="button"
  class="cookie-widget"
  data-cookie-widget
  aria-label="Cookie-Einstellungen öffnen"
  aria-haspopup="dialog"
  aria-controls="privacy-dialog"
  title="Cookie-Einstellungen"
>
  <CookiePrivacyIcon size={26} />
  <span class="sr-only">Cookie-Einstellungen öffnen</span>
</button>

<!-- Zentrierter Consent-Dialog (Overlay + Panel) -->
<div
  class="privacy-overlay"
  data-privacy-overlay
  hidden
  aria-hidden="true"
>
  <div
    class="privacy-panel"
    id="privacy-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="privacy-dialog-title"
    aria-describedby="privacy-dialog-description"
    tabindex="-1"
    data-privacy-panel
  >
    <header class="privacy-panel__head">
      <span class="privacy-panel__icon" aria-hidden="true">
        <CookiePrivacyIcon size={26} />
      </span>
      <h2 class="privacy-panel__title" id="privacy-dialog-title">Cookie-Einstellungen</h2>
      <button
        type="button"
        class="privacy-panel__close"
        data-privacy-close
        aria-label="Dialog schließen"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M6 18L18 6" />
        </svg>
      </button>
    </header>

    <div class="privacy-panel__body">
      <p class="privacy-panel__description" id="privacy-dialog-description">
        Wählen Sie aus, welche Kategorien Sie zulassen möchten. „Technisch
        notwendig" ist immer aktiv, alle anderen Kategorien sind bis zu Ihrer
        Zustimmung deaktiviert. Ihre Auswahl können Sie jederzeit über den
        Link „Cookie-Einstellungen" im Footer oder über das rote Symbol unten
        rechts wieder ändern.
      </p>

      <div class="privacy-panel__categories" data-privacy-categories></div>

      <p class="privacy-panel__links">
        <a href="/datenschutz">Datenschutzerklärung</a>
        <span aria-hidden="true">·</span>
        <a href="/impressum">Impressum</a>
      </p>
    </div>

    <footer class="privacy-panel__actions" data-privacy-actions>
      <!-- Buttons werden per JS eingefügt (drei Aktionen in Site-Button-Stil). -->
    </footer>
  </div>
</div>

<style>
  /* ---------- Widget rechts unten ---------- */
  .cookie-widget {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right, 0));
    bottom: max(1rem, env(safe-area-inset-bottom, 0));
    z-index: 140;
    width: 3.25rem;
    height: 3.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: var(--color-red);
    color: #ffffff;
    border: 2px solid var(--color-red-dark);
    border-radius: 2px;
    box-shadow: 0 6px 20px rgba(22, 22, 22, 0.28);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.2s var(--ease-out),
      box-shadow 0.2s ease;
  }

  .cookie-widget:hover {
    background: var(--color-red-dark);
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(22, 22, 22, 0.35);
  }

  .cookie-widget:focus-visible {
    outline: 3px solid var(--color-red);
    outline-offset: 3px;
    background: var(--color-red-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-widget {
      transition: none;
    }
    .cookie-widget:hover {
      transform: none;
    }
  }

  /* ---------- Overlay + zentriertes Panel ---------- */
  .privacy-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: max(1rem, env(safe-area-inset-top, 0))
             max(1rem, env(safe-area-inset-right, 0))
             max(1rem, env(safe-area-inset-bottom, 0))
             max(1rem, env(safe-area-inset-left, 0));
    background: rgba(22, 22, 22, 0.45);
  }

  .privacy-overlay[hidden] {
    display: none;
  }

  .privacy-panel {
    position: relative;
    width: min(100%, 42rem);
    /* Höhe so bemessen, dass der Aktionen-Footer und der Beschreibungstext
       auf typischen Desktop-Viewports (>= 720 px) sichtbar sind, ohne
       scrollen zu müssen. Die Kategorien-Liste scrollt intern, falls die
       Anzeigehöhe knapp wird. */
    max-height: min(calc(100dvh - 2rem), 46rem);
    display: flex;
    flex-direction: column;
    background: #ffffff;
    color: var(--color-ink);
    border: 2px solid var(--color-ink);
    border-top: 4px solid var(--color-red);
    border-radius: 2px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    outline: none;
    animation: privacy-panel-in 0.25s var(--ease-out);
  }

  @keyframes privacy-panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .privacy-panel {
      animation: none;
    }
  }

  .privacy-panel__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
    flex-shrink: 0;
  }

  .privacy-panel__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    background: var(--color-red);
    color: #ffffff;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .privacy-panel__title {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.2;
    color: var(--color-ink);
  }

  .privacy-panel__close {
    background: none;
    border: 1px solid transparent;
    padding: 0.35rem;
    color: var(--color-ink);
    cursor: pointer;
    line-height: 0;
    border-radius: 2px;
  }

  .privacy-panel__close:hover {
    background: var(--color-bg-soft);
  }

  .privacy-panel__close:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }

  .privacy-panel__body {
    padding: 1rem 1.25rem 0.25rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    flex: 1;
    min-height: 0;
  }

  .privacy-panel__description {
    margin: 0 0 1rem;
    color: var(--color-slate);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .privacy-panel__links {
    margin: 1rem 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.85rem;
    color: var(--color-slate);
  }

  .privacy-panel__links a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .privacy-panel__links a:hover {
    color: var(--color-red);
  }

  /* ---------- Kategorien-Liste ---------- */
  .privacy-panel__categories {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .privacy-category {
    border: 1px solid var(--color-line);
    background: #ffffff;
  }

  .privacy-category__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.95rem;
  }

  .privacy-category__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-ink);
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .privacy-category__meta {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-slate);
    font-weight: 600;
  }

  .privacy-category__body {
    padding: 0 0.95rem 0.75rem;
  }

  .privacy-category__desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-slate);
    line-height: 1.5;
  }

  .privacy-category__details-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.6rem;
    background: none;
    border: 0;
    padding: 0;
    color: var(--color-red);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .privacy-category__details-toggle:hover {
    color: var(--color-red-dark);
    text-decoration: underline;
  }

  .privacy-category__details-toggle svg {
    transition: transform 0.2s ease;
  }

  .privacy-category__details-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .privacy-category__details {
    margin-top: 0.7rem;
    padding: 0.7rem 0.85rem;
    background: var(--color-bg-soft);
    border-left: 3px solid var(--color-red);
    font-size: 0.82rem;
    color: var(--color-slate);
    line-height: 1.5;
  }

  .privacy-category__details[hidden] {
    display: none;
  }

  .privacy-category__details p {
    margin: 0 0 0.5rem;
  }

  .privacy-category__details p:last-child {
    margin: 0;
  }

  .privacy-service-mini {
    border-top: 1px solid var(--color-line);
    padding-top: 0.55rem;
    margin-top: 0.55rem;
  }

  .privacy-service-mini:first-of-type {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }

  .privacy-service-mini__title {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-ink);
    margin-bottom: 0.2rem;
  }

  .privacy-service-mini dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.15rem 0.6rem;
    font-size: 0.78rem;
  }

  .privacy-service-mini dt {
    color: var(--color-ink);
    font-weight: 600;
  }

  .privacy-service-mini dd {
    margin: 0;
  }

  .privacy-service-mini a {
    color: var(--color-red);
  }

  /* ---------- Toggle-Schalter ---------- */
  .privacy-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    cursor: pointer;
    padding: 0;
  }

  .privacy-toggle input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .privacy-toggle input:disabled {
    cursor: not-allowed;
  }

  .privacy-toggle__track {
    display: inline-block;
    width: 2.6rem;
    height: 1.4rem;
    background: #b8bec4;
    position: relative;
    border-radius: 2px;
    transition: background-color 0.2s ease;
  }

  .privacy-toggle__track::after {
    content: '';
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: 1rem;
    height: 1rem;
    background: #ffffff;
    border-radius: 1px;
    transition: transform 0.2s var(--ease-out);
  }

  .privacy-toggle input:checked + .privacy-toggle__track {
    background: var(--color-red);
  }

  .privacy-toggle input:checked + .privacy-toggle__track::after {
    transform: translateX(1.2rem);
  }

  .privacy-toggle input:disabled + .privacy-toggle__track {
    background: var(--color-dark);
    opacity: 0.55;
  }

  .privacy-toggle input:focus-visible + .privacy-toggle__track {
    outline: 2px solid var(--color-red-dark);
    outline-offset: 2px;
  }

  /* ---------- Aktionen-Footer ---------- */
  .privacy-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.9rem 1.25rem 1rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg-soft);
    flex-shrink: 0;
  }

  /* Kompakte Ausprägung der globalen `.btn`-Klassen für die Buttonleiste im
     Dialog. Der `—`-Präfix samt Hover-Translate wird hier unterdrückt, damit
     die Buttonbreite konstant bleibt. */
  .privacy-panel__actions .btn {
    padding: 0.7rem 1.05rem;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    box-shadow: none;
    flex: 1 1 auto;
    min-width: 0;
  }

  .privacy-panel__actions .btn--outline {
    padding: calc(0.7rem - 2px) calc(1.05rem - 2px);
  }

  .privacy-panel__actions .btn::before {
    display: none;
  }

  /* ---------- Layout-Anpassung für kleine Bildschirme ---------- */
  @media (max-width: 32rem) {
    .privacy-panel__head {
      padding: 0.8rem 1rem;
      gap: 0.7rem;
    }
    .privacy-panel__icon {
      width: 2.2rem;
      height: 2.2rem;
    }
    .privacy-panel__body,
    .privacy-panel__actions {
      padding-inline: 1rem;
    }
    .privacy-panel__actions .btn {
      flex: 1 1 100%;
    }
    .privacy-service-mini dl {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import type {
    ConsentCategoryDefinition,
    ConsentServiceDefinition,
  } from '../scripts/consent/registry';
  import { consentManager } from '../scripts/consent/manager';

  const overlay = document.querySelector<HTMLDivElement>('[data-privacy-overlay]');
  const panel = document.querySelector<HTMLDivElement>('[data-privacy-panel]');
  const categoriesContainer = document.querySelector<HTMLDivElement>('[data-privacy-categories]');
  const actionsContainer = document.querySelector<HTMLElement>('[data-privacy-actions]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-privacy-close]');
  const widget = document.querySelector<HTMLButtonElement>('[data-cookie-widget]');

  if (!overlay || !panel || !categoriesContainer || !actionsContainer) {
    throw new Error('[consent] Erwartete DOM-Struktur des Privacy-Dialogs fehlt.');
  }

  const FOCUSABLE_SELECTOR =
    'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  let lastFocused: HTMLElement | null = null;
  /** Merkt sich pro Kategorie-ID, ob die Details-Klappe offen ist. */
  const detailsOpenState = new Map<string, boolean>();

  function setPanelInert(inert: boolean): void {
    if (inert) {
      overlay?.setAttribute('hidden', '');
      overlay?.setAttribute('aria-hidden', 'true');
      document.documentElement.style.removeProperty('overflow');
    } else {
      overlay?.removeAttribute('hidden');
      overlay?.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
    }
  }

  function renderContent(): void {
    const categories = consentManager.allCategories;
    const current = consentManager.categories;

    categoriesContainer!.replaceChildren();
    for (const cat of categories) {
      const services = consentManager.getServicesByCategory(cat.id);
      categoriesContainer!.appendChild(
        buildCategoryCard(cat, current[cat.id] === true, services),
      );
    }

    actionsContainer!.replaceChildren(
      buildButton({
        label: 'Alle ablehnen',
        className: 'btn btn--outline btn--small',
        onClick: () => {
          consentManager.rejectAll();
          closeDialog();
        },
      }),
      buildButton({
        label: 'Alle akzeptieren',
        className: 'btn btn--red btn--small',
        onClick: () => {
          consentManager.acceptAll();
          closeDialog();
        },
      }),
      buildButton({
        label: 'Auswahl speichern',
        className: 'btn btn--outline btn--small',
        onClick: () => {
          const selection: Record<string, boolean> = {};
          categoriesContainer!
            .querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-category]')
            .forEach((input) => {
              const id = input.dataset.category;
              if (id) selection[id] = input.checked;
            });
          consentManager.saveSelection(selection);
          closeDialog();
        },
      }),
    );
  }

  function buildCategoryCard(
    cat: ConsentCategoryDefinition,
    checked: boolean,
    services: ConsentServiceDefinition[],
  ): HTMLDivElement {
    const wrap = document.createElement('div');
    wrap.className = 'privacy-category';

    const head = document.createElement('div');
    head.className = 'privacy-category__head';

    const label = document.createElement('span');
    label.className = 'privacy-category__label';
    label.append(document.createTextNode(cat.label));
    if (cat.required) {
      const meta = document.createElement('span');
      meta.className = 'privacy-category__meta';
      meta.textContent = 'Immer aktiv';
      label.append(meta);
    }
    head.appendChild(label);

    const toggle = document.createElement('label');
    toggle.className = 'privacy-toggle';
    const input = document.createElement('input');
    input.type = 'checkbox';
    input.dataset.category = cat.id;
    input.checked = cat.required ? true : checked;
    input.disabled = cat.required;
    input.setAttribute('aria-label', `Kategorie ${cat.label} zulassen`);
    const track = document.createElement('span');
    track.className = 'privacy-toggle__track';
    toggle.append(input, track);
    head.appendChild(toggle);

    wrap.appendChild(head);

    const body = document.createElement('div');
    body.className = 'privacy-category__body';

    const desc = document.createElement('p');
    desc.className = 'privacy-category__desc';
    desc.textContent = cat.description;
    body.appendChild(desc);

    const detailsId = `privacy-cat-${cat.id}-details`;
    const detailsBtn = document.createElement('button');
    detailsBtn.type = 'button';
    detailsBtn.className = 'privacy-category__details-toggle';
    detailsBtn.setAttribute('aria-expanded', String(detailsOpenState.get(cat.id) === true));
    detailsBtn.setAttribute('aria-controls', detailsId);

    const detailsLabel = document.createElement('span');
    detailsLabel.className = 'privacy-category__details-label';
    detailsLabel.textContent = 'Details zu dieser Kategorie';
    detailsBtn.append(detailsLabel);

    const chevron = buildChevron();
    detailsBtn.append(chevron);
    body.appendChild(detailsBtn);

    const details = document.createElement('div');
    details.className = 'privacy-category__details';
    details.id = detailsId;
    if (!detailsOpenState.get(cat.id)) {
      details.hidden = true;
    }
    fillCategoryDetails(details, cat, services);
    body.appendChild(details);

    detailsBtn.addEventListener('click', () => {
      const nextOpen = details.hidden;
      details.hidden = !nextOpen;
      detailsBtn.setAttribute('aria-expanded', String(nextOpen));
      detailsOpenState.set(cat.id, nextOpen);
    });

    wrap.appendChild(body);
    return wrap;
  }

  function buildChevron(): SVGSVGElement {
    const svgNs = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(svgNs, 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('width', '14');
    svg.setAttribute('height', '14');
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '2');
    svg.setAttribute('stroke-linecap', 'round');
    svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');
    const path = document.createElementNS(svgNs, 'path');
    path.setAttribute('d', 'M6 9l6 6 6-6');
    svg.append(path);
    return svg;
  }

  function fillCategoryDetails(
    container: HTMLElement,
    cat: ConsentCategoryDefinition,
    services: ConsentServiceDefinition[],
  ): void {
    container.replaceChildren();

    if (services.length === 0) {
      const info = document.createElement('p');
      info.textContent =
        cat.id === 'necessary'
          ? 'Diese Kategorie umfasst ausschließlich die First-Party-Speicherung Ihrer Cookie-Entscheidung im lokalen Browser-Speicher (kein Cookie, kein Drittanbieter). Sie ist zwingend erforderlich und kann nicht deaktiviert werden.'
          : 'Aktuell sind in dieser Kategorie keine Dienste eingebunden. Sollte sich das ändern, aktualisieren wir die Datenschutzerklärung und fragen Ihre Einwilligung erneut ab.';
      container.appendChild(info);
      return;
    }

    for (const service of services) {
      const box = document.createElement('div');
      box.className = 'privacy-service-mini';

      const title = document.createElement('span');
      title.className = 'privacy-service-mini__title';
      title.textContent = service.name;
      box.appendChild(title);

      const dl = document.createElement('dl');
      const rows: Array<[string, string | HTMLElement]> = [
        ['Anbieter', service.provider],
        ['Zweck', service.purpose],
      ];
      if (service.storage.length > 0) {
        rows.push([
          'Speicherung',
          service.storage
            .map((s) => `${s.name} (${s.type}, ${s.duration})`)
            .join('; '),
        ]);
      }
      if (service.thirdCountryTransfer) {
        rows.push(['Drittland', service.thirdCountryTransfer]);
      }
      if (service.providerPrivacyUrl) {
        const link = document.createElement('a');
        link.href = service.providerPrivacyUrl;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = 'Datenschutzerklärung des Anbieters';
        rows.push(['Anbieter-Info', link]);
      }
      for (const [term, value] of rows) {
        const dt = document.createElement('dt');
        dt.textContent = term;
        const dd = document.createElement('dd');
        if (typeof value === 'string') {
          dd.textContent = value;
        } else {
          dd.appendChild(value);
        }
        dl.append(dt, dd);
      }
      box.appendChild(dl);
      container.appendChild(box);
    }
  }

  interface ButtonConfig {
    label: string;
    className: string;
    onClick: () => void;
  }

  function buildButton(config: ButtonConfig): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = config.className;
    btn.textContent = config.label;
    btn.addEventListener('click', config.onClick);
    return btn;
  }

  function openDialog(): void {
    lastFocused = (document.activeElement as HTMLElement | null) ?? null;
    renderContent();
    setPanelInert(false);
    panel!.focus({ preventScroll: true });
  }

  function closeDialog(): void {
    setPanelInert(true);
    if (lastFocused && document.body.contains(lastFocused)) {
      lastFocused.focus({ preventScroll: true });
    }
    lastFocused = null;
  }

  function isOpen(): boolean {
    return overlay!.hasAttribute('hidden') === false;
  }

  function trapFocus(event: KeyboardEvent): void {
    if (!isOpen()) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      /* Escape schließt den Dialog. Es wird NICHT als Zustimmung gewertet –
         der Nutzer kann den Dialog jederzeit über das rote Widget oder den
         Footer-Link erneut öffnen. */
      closeDialog();
      return;
    }
    if (event.key !== 'Tab') return;
    const focusable = Array.from(
      panel!.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR),
    ).filter((el) => !el.hasAttribute('hidden'));
    if (focusable.length === 0) {
      event.preventDefault();
      panel!.focus();
      return;
    }
    const first = focusable[0]!;
    const last = focusable[focusable.length - 1]!;
    const active = document.activeElement as HTMLElement | null;
    if (event.shiftKey && (active === first || active === panel)) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  }

  document.addEventListener('keydown', trapFocus);

  widget?.addEventListener('click', () => {
    if (isOpen()) {
      closeDialog();
    } else {
      openDialog();
    }
  });

  closeBtn?.addEventListener('click', () => closeDialog());

  overlay.addEventListener('click', (event) => {
    if (event.target === overlay) {
      /* Klick auf das Overlay schließt den Dialog wie Escape – wertet nichts. */
      closeDialog();
    }
  });

  document.addEventListener('consent:open', () => openDialog());

  document.addEventListener('consent:changed', () => {
    if (isOpen()) renderContent();
  });

  /* Initial: nur öffnen, wenn noch keine Entscheidung vorliegt. */
  if (!consentManager.hasDecided()) {
    requestAnimationFrame(() => openDialog());
  }
</script>
