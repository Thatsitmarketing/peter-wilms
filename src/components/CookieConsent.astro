---
/**
 * Zentrale Consent-UI im Banner-Stil (Vorbild CCM19):
 *   1. Fest sichtbares Cookie-Widget unten rechts (öffnet den Dialog).
 *   2. Großer Consent-Banner mit Titel, ausführlicher Beschreibung,
 *      horizontaler Kategorien-Auswahl (Checkboxen + Info-Icons) und drei
 *      Aktions-Buttons "Ablehnen", "Speichern", "Alles akzeptieren".
 *   3. Unten eine schmale Fußleiste mit Links zu Impressum,
 *      Datenschutzhinweis und den Cookie-Einstellungen.
 *
 * Optionale Dienste werden ausschließlich in der Service-Registry
 * (`src/scripts/consent/registry.ts`) gepflegt.
 */
import CookiePrivacyIcon from './CookiePrivacyIcon.astro';
---

<!-- Rotes eckiges Cookie-Widget (immer sichtbar, rechts unten) -->
<button
  type="button"
  class="cookie-widget"
  data-cookie-widget
  aria-label="Cookie-Einstellungen öffnen"
  aria-haspopup="dialog"
  aria-controls="privacy-dialog"
  title="Cookie-Einstellungen"
>
  <CookiePrivacyIcon size={26} />
  <span class="sr-only">Cookie-Einstellungen öffnen</span>
</button>

<!-- Consent-Banner (Overlay + Panel) -->
<div
  class="privacy-overlay"
  data-privacy-overlay
  hidden
  aria-hidden="true"
>
  <div
    class="privacy-panel"
    id="privacy-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="privacy-dialog-title"
    aria-describedby="privacy-dialog-description"
    tabindex="-1"
    data-privacy-panel
  >
    <button
      type="button"
      class="privacy-panel__close"
      data-privacy-close
      aria-label="Dialog schließen"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M6 18L18 6" />
      </svg>
    </button>

    <div class="privacy-panel__body">
      <h2 class="privacy-panel__title" id="privacy-dialog-title">
        Wir nutzen Cookies und andere Technologien.
      </h2>
      <p class="privacy-panel__description" id="privacy-dialog-description">
        Diese Website nutzt Cookies und vergleichbare Funktionen zur Verarbeitung
        von Endgeräteinformationen und personenbezogenen Daten. Die Verarbeitung
        dient der Einbindung von Inhalten, externen Diensten und Elementen
        Dritter, der statistischen Analyse/Messung, der personalisierten Werbung
        sowie der Einbindung sozialer Medien. Je nach Funktion werden dabei
        Daten an Dritte weitergegeben und an Dritte in Ländern, in denen kein
        angemessenes Datenschutzniveau vorliegt und von diesen verarbeitet wird,
        z. B. die USA. Ihre Einwilligung ist stets freiwillig, für die Nutzung
        unserer Website nicht erforderlich und kann jederzeit über das rote
        Cookie-Symbol unten rechts abgelehnt oder widerrufen werden.
      </p>

      <div class="privacy-panel__categories" data-privacy-categories></div>

      <div class="privacy-panel__actions" data-privacy-actions></div>
    </div>

    <footer class="privacy-panel__footer">
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutzhinweis</a>
      <a href="/datenschutz#cookies" data-privacy-settings-link>Einstellungen</a>
    </footer>
  </div>
</div>

<style>
  /* ---------- Widget rechts unten ---------- */
  .cookie-widget {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right, 0));
    bottom: max(1rem, env(safe-area-inset-bottom, 0));
    z-index: 140;
    width: 3.25rem;
    height: 3.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: var(--color-red);
    color: #ffffff;
    border: 2px solid var(--color-red-dark);
    border-radius: 2px;
    box-shadow: 0 6px 20px rgba(22, 22, 22, 0.28);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.2s var(--ease-out),
      box-shadow 0.2s ease;
  }

  .cookie-widget:hover {
    background: var(--color-red-dark);
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(22, 22, 22, 0.35);
  }

  .cookie-widget:focus-visible {
    outline: 3px solid var(--color-red);
    outline-offset: 3px;
    background: var(--color-red-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-widget {
      transition: none;
    }
    .cookie-widget:hover {
      transform: none;
    }
  }

  /* ---------- Overlay + Banner-Panel ---------- */
  .privacy-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: max(1rem, env(safe-area-inset-top, 0))
             max(1rem, env(safe-area-inset-right, 0))
             max(1rem, env(safe-area-inset-bottom, 0))
             max(1rem, env(safe-area-inset-left, 0));
    background: rgba(22, 22, 22, 0.55);
  }

  .privacy-overlay[hidden] {
    display: none;
  }

  .privacy-panel {
    position: relative;
    width: min(100%, 68rem);
    max-height: min(calc(100dvh - 2rem), 46rem);
    display: flex;
    flex-direction: column;
    background: #ffffff;
    color: var(--color-ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    outline: none;
    animation: privacy-panel-in 0.25s var(--ease-out);
  }

  @keyframes privacy-panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .privacy-panel {
      animation: none;
    }
  }

  .privacy-panel__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: none;
    border: 1px solid transparent;
    padding: 0.4rem;
    color: var(--color-slate);
    cursor: pointer;
    line-height: 0;
    border-radius: 2px;
    z-index: 1;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .privacy-panel__close:hover {
    background: var(--color-bg-soft);
    color: var(--color-ink);
  }

  .privacy-panel__close:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }

  .privacy-panel__body {
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.5rem, 4vw, 3rem)
             clamp(1.25rem, 2.5vw, 1.75rem);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    flex: 1;
    min-height: 0;
  }

  .privacy-panel__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.2;
    margin: 0 0 1rem;
    color: var(--color-ink);
    padding-right: 2.25rem;
  }

  .privacy-panel__description {
    margin: 0 0 1.5rem;
    color: var(--color-slate);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ---------- Kategorien-Zeile (horizontal, wrap bei Bedarf) ---------- */
  .privacy-panel__categories {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.25rem;
    margin: 0 0 1.75rem;
  }

  .privacy-category {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    user-select: none;
  }

  .privacy-category__checkbox {
    position: relative;
    display: inline-block;
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }

  .privacy-category__checkbox input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .privacy-category__checkbox input:disabled {
    cursor: not-allowed;
  }

  .privacy-category__box {
    display: block;
    width: 100%;
    height: 100%;
    background: #ffffff;
    border: 1.5px solid var(--color-ink);
    border-radius: 2px;
    position: relative;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .privacy-category__box::after {
    content: '';
    position: absolute;
    top: 0.05rem;
    left: 0.32rem;
    width: 0.35rem;
    height: 0.6rem;
    border: solid #ffffff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg) scale(0);
    transform-origin: center;
    transition: transform 0.15s var(--ease-out);
  }

  .privacy-category__checkbox input:checked + .privacy-category__box {
    background: var(--color-red);
    border-color: var(--color-red);
  }

  .privacy-category__checkbox input:checked + .privacy-category__box::after {
    transform: rotate(45deg) scale(1);
  }

  .privacy-category__checkbox input:disabled + .privacy-category__box {
    background: #d9d9d9;
    border-color: #b8b8b8;
  }

  .privacy-category__checkbox input:disabled:checked + .privacy-category__box::after {
    border-color: #ffffff;
  }

  .privacy-category__checkbox input:focus-visible + .privacy-category__box {
    outline: 2px solid var(--color-red);
    outline-offset: 3px;
  }

  .privacy-category__label {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-ink);
    font-weight: 500;
    line-height: 1.2;
  }

  .privacy-category__info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.05rem;
    height: 1.05rem;
    border: 1px solid var(--color-slate);
    border-radius: 50%;
    color: var(--color-slate);
    font-size: 0.68rem;
    font-weight: 700;
    font-family: var(--font-body);
    background: transparent;
    cursor: help;
    line-height: 1;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .privacy-category__info:hover,
  .privacy-category__info:focus-visible {
    color: var(--color-red);
    border-color: var(--color-red);
    outline: none;
  }

  /* ---------- Aktions-Buttons ---------- */
  .privacy-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: stretch;
  }

  .privacy-btn {
    flex: 1 1 12rem;
    min-width: 0;
    padding: 0.95rem 1.25rem;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    background: #ffffff;
    color: var(--color-red);
    border: 1.5px solid var(--color-red);
    cursor: pointer;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .privacy-btn:hover {
    background: var(--color-red);
    color: #ffffff;
  }

  .privacy-btn:focus-visible {
    outline: 2px solid var(--color-red-dark);
    outline-offset: 2px;
  }

  .privacy-btn--neutral {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .privacy-btn--neutral:hover {
    background: var(--color-ink);
    color: #ffffff;
  }

  .privacy-btn--primary {
    background: var(--color-red);
    color: #ffffff;
    border-color: var(--color-red);
  }

  .privacy-btn--primary:hover {
    background: var(--color-red-dark);
    border-color: var(--color-red-dark);
  }

  /* ---------- Fußleiste ---------- */
  .privacy-panel__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    padding: 0.85rem clamp(1.5rem, 4vw, 3rem);
    background: var(--color-bg-soft);
    border-top: 1px solid var(--color-line);
    font-size: 0.82rem;
    color: var(--color-slate);
    flex-shrink: 0;
  }

  .privacy-panel__footer a {
    color: var(--color-slate);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .privacy-panel__footer a:hover,
  .privacy-panel__footer a:focus-visible {
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    outline: none;
  }

  /* ---------- Layout-Anpassung für kleinere Bildschirme ---------- */
  @media (max-width: 48rem) {
    .privacy-panel__categories {
      gap: 0.85rem 1.5rem;
    }
    .privacy-btn {
      flex: 1 1 100%;
    }
  }

  @media (max-width: 32rem) {
    .privacy-panel__body {
      padding: 1.25rem 1.15rem 1rem;
    }
    .privacy-panel__footer {
      padding: 0.75rem 1.15rem;
    }
    .privacy-panel__title {
      font-size: 1.35rem;
    }
    .privacy-panel__description {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  import type { ConsentCategoryDefinition } from '../scripts/consent/registry';
  import { consentManager } from '../scripts/consent/manager';

  const overlay = document.querySelector<HTMLDivElement>('[data-privacy-overlay]');
  const panel = document.querySelector<HTMLDivElement>('[data-privacy-panel]');
  const categoriesContainer = document.querySelector<HTMLDivElement>('[data-privacy-categories]');
  const actionsContainer = document.querySelector<HTMLElement>('[data-privacy-actions]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-privacy-close]');
  const widget = document.querySelector<HTMLButtonElement>('[data-cookie-widget]');
  const settingsLink = document.querySelector<HTMLAnchorElement>('[data-privacy-settings-link]');

  if (!overlay || !panel || !categoriesContainer || !actionsContainer) {
    throw new Error('[consent] Erwartete DOM-Struktur des Privacy-Dialogs fehlt.');
  }

  const FOCUSABLE_SELECTOR =
    'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  let lastFocused: HTMLElement | null = null;

  function setPanelInert(inert: boolean): void {
    if (inert) {
      overlay?.setAttribute('hidden', '');
      overlay?.setAttribute('aria-hidden', 'true');
      document.documentElement.style.removeProperty('overflow');
    } else {
      overlay?.removeAttribute('hidden');
      overlay?.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
    }
  }

  function renderContent(): void {
    const categories = consentManager.allCategories;
    const current = consentManager.categories;

    categoriesContainer!.replaceChildren();
    for (const cat of categories) {
      categoriesContainer!.appendChild(
        buildCategoryChip(cat, current[cat.id] === true),
      );
    }

    actionsContainer!.replaceChildren(
      buildButton({
        label: 'Ablehnen',
        className: 'privacy-btn',
        onClick: () => {
          consentManager.rejectAll();
          closeDialog();
        },
      }),
      buildButton({
        label: 'Speichern',
        className: 'privacy-btn privacy-btn--neutral',
        onClick: () => {
          const selection: Record<string, boolean> = {};
          categoriesContainer!
            .querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-category]')
            .forEach((input) => {
              const id = input.dataset.category;
              if (id) selection[id] = input.checked;
            });
          consentManager.saveSelection(selection);
          closeDialog();
        },
      }),
      buildButton({
        label: 'Alles akzeptieren',
        className: 'privacy-btn privacy-btn--primary',
        onClick: () => {
          consentManager.acceptAll();
          closeDialog();
        },
      }),
    );
  }

  function buildCategoryChip(
    cat: ConsentCategoryDefinition,
    checked: boolean,
  ): HTMLLabelElement {
    const wrap = document.createElement('label');
    wrap.className = 'privacy-category';

    const box = document.createElement('span');
    box.className = 'privacy-category__checkbox';

    const input = document.createElement('input');
    input.type = 'checkbox';
    input.dataset.category = cat.id;
    input.checked = cat.required ? true : checked;
    input.disabled = cat.required;
    input.setAttribute('aria-label', `Kategorie ${cat.label} zulassen`);

    const visual = document.createElement('span');
    visual.className = 'privacy-category__box';

    box.append(input, visual);

    const label = document.createElement('span');
    label.className = 'privacy-category__label';
    label.textContent = cat.label;

    const info = document.createElement('span');
    info.className = 'privacy-category__info';
    info.setAttribute('role', 'img');
    info.setAttribute('tabindex', '0');
    info.setAttribute('aria-label', `Info: ${cat.description}`);
    info.setAttribute('title', cat.description);
    info.textContent = '?';

    wrap.append(box, label, info);
    return wrap;
  }

  interface ButtonConfig {
    label: string;
    className: string;
    onClick: () => void;
  }

  function buildButton(config: ButtonConfig): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = config.className;
    btn.textContent = config.label;
    btn.addEventListener('click', config.onClick);
    return btn;
  }

  function openDialog(): void {
    lastFocused = (document.activeElement as HTMLElement | null) ?? null;
    renderContent();
    setPanelInert(false);
    panel!.focus({ preventScroll: true });
  }

  function closeDialog(): void {
    setPanelInert(true);
    if (lastFocused && document.body.contains(lastFocused)) {
      lastFocused.focus({ preventScroll: true });
    }
    lastFocused = null;
  }

  function isOpen(): boolean {
    return overlay!.hasAttribute('hidden') === false;
  }

  function trapFocus(event: KeyboardEvent): void {
    if (!isOpen()) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      /* Escape schließt den Dialog. Es wird NICHT als Zustimmung gewertet –
         der Nutzer kann den Dialog jederzeit über das rote Widget oder den
         Footer-Link erneut öffnen. */
      closeDialog();
      return;
    }
    if (event.key !== 'Tab') return;
    const focusable = Array.from(
      panel!.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR),
    ).filter((el) => !el.hasAttribute('hidden'));
    if (focusable.length === 0) {
      event.preventDefault();
      panel!.focus();
      return;
    }
    const first = focusable[0]!;
    const last = focusable[focusable.length - 1]!;
    const active = document.activeElement as HTMLElement | null;
    if (event.shiftKey && (active === first || active === panel)) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  }

  document.addEventListener('keydown', trapFocus);

  widget?.addEventListener('click', () => {
    if (isOpen()) {
      closeDialog();
    } else {
      openDialog();
    }
  });

  closeBtn?.addEventListener('click', () => closeDialog());

  overlay.addEventListener('click', (event) => {
    if (event.target === overlay) {
      /* Klick auf das Overlay schließt den Dialog wie Escape – wertet nichts. */
      closeDialog();
    }
  });

  /* "Einstellungen" im Footer schließt den Dialog, damit der Sprung zum
     Anker auf der Datenschutzseite sichtbar wird. */
  settingsLink?.addEventListener('click', () => closeDialog());

  document.addEventListener('consent:open', () => openDialog());

  document.addEventListener('consent:changed', () => {
    if (isOpen()) renderContent();
  });

  /* Initial: nur öffnen, wenn noch keine Entscheidung vorliegt. */
  if (!consentManager.hasDecided()) {
    requestAnimationFrame(() => openDialog());
  }
</script>
