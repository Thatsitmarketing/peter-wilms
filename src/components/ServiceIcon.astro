---
/** Schlichte Linien-Icons für die Leistungskacheln (inline SVG, kein externer Dienst). */

interface Props {
  name: string;
}

const { name } = Astro.props;

const paths: Record<string, string> = {
  // Betoninstandsetzung – Bauwerk/Mauer
  concrete: 'M3 21h18M4 21V9l8-5 8 5v12M9 21v-6h6v6M8 12h2m4 0h2',
  // Rissverpressung – Riss mit Injektionspunkt
  injection: 'M4 4l4 5-3 4 5 3-2 5m8-17-2 5 3 4-4 3 1 5M12 2v3',
  // Oberflächen-/Korrosionsschutz – Schild
  shield: 'M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3zm-3 8 2.5 2.5L16 9',
  // PCC-/Mörtelspritzarbeiten – Sprühdüse
  spray: 'M5 14l6-6 3 3-6 6-4 1 1-4zm9-9 2 2m1 3 2-2m-5-3 1-2m3 5 2-1',
  // Höchstdruckwasserstrahlen – Wasserstrahl
  water: 'M6 4h6l-1 4h3l-6 12 1.5-8H6l1-4zm10 2c1.5 1.5 2 3 2 4.5M18.5 3c2 2 3 4.5 3 7',
  // Konstruktiver Ingenieurbau – Träger/Statik
  structure: 'M3 20h18M5 20V8h14v12M5 8l7-4 7 4M9 20v-8m6 8v-8m-6 4h6',
  // Fahrbahnübergänge – Straße
  road: 'M4 20 8 4h8l4 16M12 5v2.5m0 3.5v2.5m0 3.5V20',
  // Baustellenabsicherung – Leitkegel
  cone: 'M9 4h6l4 16H5L9 4zm-1.5 6h9m-10.5 5h12M2 20h20',
};

const d = paths[name] ?? paths.concrete;
---

<svg
  viewBox="0 0 24 24"
  width="32"
  height="32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d}></path>
</svg>
