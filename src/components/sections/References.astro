---
import MediaPlaceholder from '../MediaPlaceholder.astro';
import { references, testimonial } from '../../data/site';
---

<section class="section" id="referenzen" aria-labelledby="references-title">
  <div class="container">
    <span class="section__kicker" data-reveal>Referenzen</span>
    <h2 class="section__title" id="references-title" data-reveal>
      Ausgewählte Projekte
    </h2>
    <p class="section__intro" data-reveal>
      Ein Auszug aus über 500 abgeschlossenen Maßnahmen für Straßenbaulastträger,
      Kommunen und Bauunternehmen. <em>(Platzhalter – echte Projektdaten folgen.)</em>
    </p>

    <div class="references__grid">
      {references.map((ref, index) => (
        <!-- Reveal auf dem Wrapper, Hover-Transition auf der Karte -->
        <div data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
        <article class="reference-card">
          <div class="reference-card__media">
            <MediaPlaceholder label={`Projektfoto – ${ref.title}`} ratio="16/10" />
          </div>
          <div class="reference-card__body">
            <p class="reference-card__client">{ref.client}</p>
            <h3 class="reference-card__title">{ref.title}</h3>
            <p class="reference-card__text">{ref.text}</p>
            <ul class="reference-card__tags">
              {ref.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
        </article>
        </div>
      ))}
    </div>

    <figure class="testimonial" data-reveal>
      <div class="testimonial__avatar">
        <MediaPlaceholder label={`Porträt ${testimonial.name}`} ratio="1/1" />
      </div>
      <blockquote class="testimonial__quote">
        <p>„{testimonial.quote}"</p>
      </blockquote>
      <figcaption class="testimonial__caption">
        <strong>{testimonial.name}</strong>
        <span>{testimonial.role}, Peter Willms Bauunternehmung GmbH</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .references__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .reference-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease;
  }

  .reference-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .reference-card__media :global(.media-placeholder) {
    border-radius: 0;
    border-inline: none;
    border-top: none;
  }

  .reference-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .reference-card__client {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-dark);
    margin-bottom: 0.5rem;
  }

  .reference-card__title {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .reference-card__text {
    font-size: 0.9rem;
    color: var(--color-slate);
    margin-bottom: 1rem;
  }

  .reference-card__tags {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .reference-card__tags li {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    background: var(--color-bg-soft);
    border-radius: 999px;
    color: var(--color-slate);
  }

  /* Kundenstimme */
  .testimonial {
    margin: 3.5rem 0 0;
    display: grid;
    grid-template-columns: 6rem 1fr;
    grid-template-rows: auto auto;
    column-gap: 1.75rem;
    row-gap: 0.75rem;
    align-items: center;
    background: var(--color-bg-soft);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .testimonial__avatar {
    grid-row: 1 / 3;
    width: 6rem;
  }

  .testimonial__avatar :global(.media-placeholder) {
    border-radius: 50%;
    padding: 0.5rem;
  }

  .testimonial__avatar :global(.media-placeholder__label) {
    display: none;
  }

  .testimonial__quote {
    margin: 0;
  }

  .testimonial__quote p {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.5;
    max-width: 55ch;
  }

  .testimonial__caption {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
    color: var(--color-slate);
  }

  @media (max-width: 40rem) {
    .testimonial {
      grid-template-columns: 1fr;
    }

    .testimonial__avatar {
      grid-row: auto;
    }
  }
</style>
