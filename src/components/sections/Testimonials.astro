---
import { testimonials, testimonialsSection } from '../../data/site';
---

<section class="section section--soft testimonials" aria-labelledby="testimonials-title">
  <div class="testimonials__heading container">
    <h2 class="section__title testimonials__title" id="testimonials-title" data-reveal>
      <span>Was Auftraggeber über die</span>
      <span>Zusammenarbeit sagen</span>
    </h2>
  </div>

  <div class="testimonials__viewport" data-reveal style="--reveal-delay: 0.1s">
    <div class="testimonials__track" data-testimonials-track tabindex="0" aria-label="Kundenstimmen – horizontal scrollbar">
      {testimonials.map((item) => (
        <figure class="testimonial-card">
          <div class="testimonial-card__photo photo-placeholder" role="img" aria-label={`Platzhalter – Porträtfoto ${item.name}`}>
            <div class="photo-placeholder__tag"><span>Porträt</span></div>
          </div>
          <div class="testimonial-card__body">
            <blockquote class="testimonial-card__quote">
              <p>»{item.quote}«</p>
            </blockquote>
            <figcaption class="testimonial-card__caption">
              <strong>{item.name}</strong>
              <span>{item.role}</span>
            </figcaption>
            <div class="testimonial-card__logo" role="img" aria-label={`Platzhalter – ${item.logoLabel}`}>
              <span class="testimonial-card__logo-mark" aria-hidden="true"></span>
              <span class="testimonial-card__logo-name">{item.logoLabel}</span>
            </div>
          </div>
        </figure>
      ))}
    </div>

    <div class="testimonials__controls">
      <div class="testimonials__progress" aria-hidden="true">
        <span data-testimonials-progress></span>
      </div>
      <div class="testimonials__buttons">
        <button type="button" class="testimonials__arrow" data-testimonials-prev aria-label="Vorherige Kundenstimme">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <button type="button" class="testimonials__arrow" data-testimonials-next aria-label="Nächste Kundenstimme">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Karten sitzen 20 % vom linken Rand eingerückt. Der Titel folgt jedoch
     dem allgemeinen Sektions-Gutter (10 %), damit er bündig mit der
     Ablauf-Überschrift oben steht. */
  .testimonials {
    --testimonials-inset: 20%;
  }

  /* Überschrift folgt dem globalen .container-Gutter (10 % links). */
  .testimonials__heading {
    /* nutzt .container-Padding */
  }

  .testimonials__viewport {
    margin-top: 2.5rem;
  }

  .testimonials__title span {
    display: block;
  }

  .testimonials__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Snap richtet die Karten am 20 %-Einzug aus, nicht an der Viewport-Kante */
    scroll-padding-inline-start: var(--testimonials-inset);
    scrollbar-width: none;
    /* Karten starten links am 20 %-Rand und lassen rechts genug Luft,
       damit die nächste Karte angeschnitten sichtbar bleibt. */
    padding-inline: var(--testimonials-inset) clamp(3rem, 8vw, 6rem);
    padding-block: 1.5rem 2rem;
    /* Maus-Drag über die Karten hinweg */
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }

  .testimonials__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  /* Während des Ziehens keine unerwünschten Interaktionen mit Karten-Inhalten */
  .testimonials__track.is-dragging * {
    pointer-events: none;
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  /* Karte im Sprechblasen-Stil: weißes Panel mit weichem Schatten und
     einer Spitze unten links (wie in der Referenz). */
  .testimonial-card {
    position: relative;
    flex: 0 0 min(52rem, 88vw);
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: minmax(11rem, 16rem) minmax(0, 1fr);
    gap: 2.5rem;
    margin: 0;
    background: #fff;
    padding: 2.5rem 3rem 2.75rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    align-items: stretch;
  }

  /* Sprechblasen-Spitze unten links */
  .testimonial-card::after {
    content: '';
    position: absolute;
    left: 3.5rem;
    bottom: -0.9rem;
    width: 1.6rem;
    height: 1rem;
    background: #fff;
    clip-path: polygon(0 0, 100% 0, 20% 100%);
    box-shadow: 0 12px 20px rgba(0, 0, 0, 0.06);
  }

  /* Portrait ragt oben aus dem Panel heraus, so wie die Kögel-Referenz
     die Person mit Kopf über den Kartenrand zeigt. */
  .testimonial-card__photo {
    align-self: end;
    margin-top: -3.5rem;
    aspect-ratio: 3 / 4;
    min-height: 18rem;
  }

  .testimonial-card__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
  }

  .testimonial-card__quote {
    margin: 0;
  }

  .testimonial-card__quote p {
    margin: 0;
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-ink);
  }

  .testimonial-card__caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .testimonial-card__caption strong {
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }

  .testimonial-card__caption span {
    font-size: 0.85rem;
    color: var(--color-slate);
  }

  /* Prominentes Logo unten mit Bildmarke + Wortmarke – vgl. „MERKUR GROUP". */
  .testimonial-card__logo {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    text-transform: uppercase;
  }

  .testimonial-card__logo-mark {
    display: inline-block;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: repeating-conic-gradient(
      var(--color-ink) 0deg 15deg,
      transparent 15deg 30deg
    );
    mask: radial-gradient(circle at center, transparent 0 26%, #000 27% 100%);
    -webkit-mask: radial-gradient(circle at center, transparent 0 26%, #000 27% 100%);
    position: relative;
  }

  .testimonial-card__logo-mark::after {
    content: '';
    position: absolute;
    inset: 26%;
    border-radius: 50%;
    background: var(--color-ink);
  }

  /* Fortschrittsbalken + Prev/Next-Pfeile, wie im Ablauf. */
  .testimonials__controls {
    margin-top: 2.5rem;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .testimonials__progress {
    flex: 1;
    height: 3px;
    background: #e0e0e0;
    position: relative;
    overflow: hidden;
  }

  .testimonials__progress span {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 25%;
    background: var(--color-dark);
    transition: width 0.2s ease, left 0.2s ease;
  }

  .testimonials__buttons {
    display: flex;
    gap: 0.6rem;
  }

  .testimonials__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-line);
    background: #fff;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .testimonials__arrow:hover {
    background: var(--color-red);
    border-color: var(--color-red);
    color: #fff;
  }

  .testimonials__arrow:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  /* Auf mittleren Viewports 20 % Einzug etwas reduzieren, damit Inhalt
     nicht zu schmal wird. */
  @media (max-width: 62rem) {
    .testimonials {
      --testimonials-inset: 12%;
    }
  }

  @media (max-width: 48rem) {
    .testimonials {
      --testimonials-inset: var(--gutter);
    }

    .testimonial-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem 1.75rem 2.25rem;
    }

    .testimonial-card__photo {
      margin-top: -2.5rem;
      aspect-ratio: 16 / 10;
      min-height: 0;
    }

    .testimonial-card::after {
      left: 2rem;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-testimonials-track]');
  const bar = document.querySelector<HTMLElement>('[data-testimonials-progress]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-testimonials-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-testimonials-next]');

  if (track && bar) {
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const ratio = track.clientWidth / track.scrollWidth;
      const pos = max > 0 ? track.scrollLeft / max : 0;
      bar.style.width = `${Math.max(ratio * 100, 8)}%`;
      bar.style.left = `${pos * (100 - Math.max(ratio * 100, 8))}%`;
      if (prevBtn) prevBtn.disabled = track.scrollLeft <= 1;
      if (nextBtn) nextBtn.disabled = track.scrollLeft >= max - 1;
    };
    update();
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);

    // Distanz einer Kartenspanne (Kartenbreite + Gap) – für Prev/Next & Snap.
    const stepDistance = () => {
      const card = track.querySelector<HTMLElement>('.testimonial-card');
      if (!card) return 500;
      const style = getComputedStyle(track);
      const gap = parseFloat(style.columnGap || style.gap || '0') || 0;
      return card.offsetWidth + gap;
    };

    prevBtn?.addEventListener('click', () => {
      track.scrollBy({ left: -stepDistance(), behavior: 'smooth' });
    });
    nextBtn?.addEventListener('click', () => {
      track.scrollBy({ left: stepDistance(), behavior: 'smooth' });
    });

    /**
     * Maus-Drag-to-Scroll mit weichem Trägheits-Ausrollen (rAF-Animation
     * mit exponentiellem Abklingen). Touch nutzt weiter das native
     * horizontale Scrollen, daher ignorieren wir Pointer vom Typ "touch".
     * Ab einem Schwellwert von 5 px wird ein echter Drag erkannt – darunter
     * zählt der Klick als Klick, damit Links/Buttons in den Karten
     * funktionieren.
     */
    const DRAG_THRESHOLD = 5;
    let pointerId: number | null = null;
    let startX = 0;
    let startScroll = 0;
    let velocityX = 0;
    let lastX = 0;
    let lastTime = 0;
    let dragging = false;

    // rAF-Momentum-Animation
    let momentumRaf: number | null = null;
    const cancelMomentum = () => {
      if (momentumRaf !== null) {
        cancelAnimationFrame(momentumRaf);
        momentumRaf = null;
      }
    };

    const startMomentum = (initialVelocity: number) => {
      cancelMomentum();
      // Skalierung: px/ms → wir animieren mit exponentiellem Abklingen und
      // verlängern die "Ausrollphase" pro Frame um einen weichen Faktor.
      let velocity = initialVelocity; // in px/ms
      let lastFrame = performance.now();
      // Nach ~500 ms sanft auf 0 abklingen; snap darf wieder greifen, sobald
      // die Momentum-Phase beendet ist.
      const friction = 0.94; // pro 16 ms Frame
      const minVelocity = 0.02;

      const step = (now: number) => {
        const dt = Math.max(1, now - lastFrame);
        lastFrame = now;
        // Momentumrichtung: velocity positiv → Finger zog nach rechts →
        // scrollLeft sinkt, also mit -velocity multiplizieren.
        track.scrollLeft -= velocity * dt;
        // Reibung, angepasst an dt (Zielrate 60 fps)
        velocity *= Math.pow(friction, dt / 16);
        if (Math.abs(velocity) < minVelocity) {
          momentumRaf = null;
          // Snap wieder aktiv – zum nächsten Snap-Punkt animieren
          const step = stepDistance();
          const target = Math.round(track.scrollLeft / step) * step;
          track.scrollTo({ left: target, behavior: 'smooth' });
          return;
        }
        momentumRaf = requestAnimationFrame(step);
      };
      momentumRaf = requestAnimationFrame(step);
    };

    const onDown = (event: PointerEvent) => {
      if (event.pointerType === 'touch') return;
      if (event.button !== 0) return;
      cancelMomentum();
      pointerId = event.pointerId;
      startX = event.clientX;
      startScroll = track.scrollLeft;
      lastX = event.clientX;
      lastTime = performance.now();
      velocityX = 0;
      dragging = false;
    };

    const onMove = (event: PointerEvent) => {
      if (pointerId === null || event.pointerId !== pointerId) return;
      const dx = event.clientX - startX;
      if (!dragging) {
        if (Math.abs(dx) < DRAG_THRESHOLD) return;
        dragging = true;
        track.classList.add('is-dragging');
        track.setPointerCapture(pointerId);
      }
      track.scrollLeft = startScroll - dx;
      const now = performance.now();
      const dt = now - lastTime;
      if (dt > 0) {
        // Gleitender Mittelwert für stabilere Velocity
        const instantV = (event.clientX - lastX) / dt;
        velocityX = velocityX * 0.6 + instantV * 0.4;
      }
      lastX = event.clientX;
      lastTime = now;
      event.preventDefault();
    };

    const endDrag = (event: PointerEvent) => {
      if (pointerId === null || event.pointerId !== pointerId) return;
      if (dragging) {
        try { track.releasePointerCapture(pointerId); } catch {}
        track.classList.remove('is-dragging');
        // Weiches Ausrollen mit Momentum-Animation
        if (Math.abs(velocityX) > 0.05) {
          startMomentum(velocityX);
        } else {
          // Kein nennenswerter Schwung – nur sanft zum nächsten Snap
          const step = stepDistance();
          const target = Math.round(track.scrollLeft / step) * step;
          track.scrollTo({ left: target, behavior: 'smooth' });
        }
        // Klicks, die als Drag endeten, unterdrücken
        const suppress = (ev: Event) => {
          ev.stopPropagation();
          ev.preventDefault();
          track.removeEventListener('click', suppress, true);
        };
        track.addEventListener('click', suppress, true);
      }
      pointerId = null;
      dragging = false;
    };

    track.addEventListener('pointerdown', onDown);
    track.addEventListener('pointermove', onMove);
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    // Bildern das native Drag-Verhalten wegnehmen, damit der Slider-Drag greift
    track.querySelectorAll('img').forEach((img) => {
      img.setAttribute('draggable', 'false');
    });
    track.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>
