---
import { processSection, processSteps } from '../../data/site';
---

<section class="process" id="ablauf" aria-labelledby="process-title">
  <!-- Pinned Horizontal-Scroll:
       Der komplette Sektions-Inhalt (Titel + Intro + Steps + Controls) sitzt
       im Sticky-Viewport und bleibt gemeinsam an der Navigation kleben,
       während der Track horizontal durchgescrollt wird. -->
  <div class="process__stage" data-process-stage>
    <div class="process__viewport" data-process-viewport>
      <div class="container process__intro">
        <h2 class="section__title" id="process-title" data-reveal>{processSection.title}</h2>
        <p class="section__intro" data-reveal style="--reveal-delay: 0.1s">{processSection.intro}</p>
      </div>

      <div class="process__track" data-process-track>
        {processSteps.map((step, index) => (
          <>
            <article class:list={['process-card', `process-card--${step.theme}`]} data-process-card>
              <p class="process-card__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </p>
              <p class="process-card__chip">{step.chip}</p>
              <h3 class="process-card__subtitle">{step.subtitle}</h3>
              <p class="process-card__text">{step.text}</p>
            </article>
            <div class="process__photo photo-placeholder" role="img" aria-label={`Platzhalter – ${step.photoLabel}`}>
              <div class="photo-placeholder__tag"><span>{step.photoLabel}</span></div>
            </div>
          </>
        ))}
        <!-- Expliziter Spacer am Ende: schiebt Schritt 4 nach links, sodass
             am Ende des Scrolls sichtbar Freiraum rechts bleibt. -->
        <div class="process__end-spacer" aria-hidden="true"></div>
      </div>

      <div class="container process__controls">
        <div class="process__progress" aria-hidden="true">
          <span class="process__progress-bar" data-process-progress></span>
        </div>
        <div class="process__buttons">
          <button type="button" class="process__arrow" data-process-prev aria-label="Vorherige Schritte">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
          </button>
          <button type="button" class="process__arrow" data-process-next aria-label="Nächste Schritte">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    padding-top: clamp(3rem, 6vw, 5rem);
    /* 8 vh Abstand nach der Navigation, bevor der nächste Abschnitt beginnt */
    padding-bottom: 8vh;
  }

  /* Stage bestimmt die vertikale Scroll-Distanz für den Sticky-Effekt.
     Die Höhe wird zur Laufzeit vom JS gesetzt. */
  .process__stage {
    position: relative;
    height: 300vh;
  }

  /* Sticky-Viewport enthält den kompletten Sektions-Inhalt (Intro + Steps +
     Controls) und klebt mittig im Bildschirm, während intern der Track
     horizontal durchgescrollt wird. Kompakte Höhe: Intro + 35 vh Kacheln +
     Controls sitzen dicht beieinander. */
  .process__viewport {
    position: sticky;
    /* Mittig auf dem Screen: (100vh - 62vh) / 2 ≈ 19vh */
    top: 18vh;
    height: 62vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* Intro sitzt oben im Viewport, dicht am Slider – kein zusätzliches Padding */
  .process__intro {
    flex-shrink: 0;
    padding-top: 0;
    padding-bottom: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .process__intro .section__title {
    max-width: 75%;
    margin-bottom: 0.75rem;
  }

  .process__intro .section__intro {
    max-width: 75%;
    margin: 0;
  }

  @media (max-width: 62rem) {
    .process__intro .section__title,
    .process__intro .section__intro {
      max-width: 100%;
    }
  }

  /* Horizontaler Track: nimmt den mittleren, größten Raum ein */
  .process__track {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-inline: var(--gutter);
    will-change: transform;
    transform: translate3d(0, 0, 0);
    min-height: 0;
  }

  /* Spacer so groß wie der Container-Rand rechts (--gutter, ~10 %). Damit
     endet Foto 4 am Ende des Scrolls exakt bündig mit dem rechten Pfeil
     der Steuerung darunter – beide sitzen an der Container-Kante bei 90 vw. */
  .process__end-spacer {
    flex: 0 0 var(--gutter);
  }

  .process-card {
    flex: 0 0 clamp(20rem, 34vw, 30rem);
    /* Nur 35 vh hoch – Kacheln bleiben schlank */
    height: 35vh;
    min-height: 35vh;
    padding: clamp(1.25rem, 2vw, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .process__photo {
    flex: 0 0 clamp(14rem, 22vw, 22rem);
    height: 35vh;
    min-height: 35vh;
  }

  .process-card--light {
    background: var(--color-bg-soft);
    color: var(--color-ink);
  }

  .process-card--dark {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .process-card--red {
    background: var(--color-red);
    color: #fff;
  }

  .process-card__number {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 700;
    line-height: 0.9;
    margin: 0 0 0.75rem;
  }

  .process-card--light .process-card__number {
    color: var(--color-ink);
  }

  .process-card__chip {
    align-self: flex-start;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.25rem 0.75rem;
    margin-bottom: 0.6rem;
    background: var(--color-red);
    color: #fff;
  }

  .process-card--red .process-card__chip {
    background: var(--color-dark);
  }

  .process-card__subtitle {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }

  .process-card__text {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .process-card--light .process-card__text {
    color: var(--color-slate);
  }

  .process-card--dark .process-card__text {
    color: var(--color-on-dark-soft);
  }

  /* Controls sitzen dicht unter dem Track im Viewport */
  .process__controls {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: clamp(0.5rem, 1vw, 0.85rem);
    padding-bottom: 0;
  }

  .process__progress {
    flex: 1;
    height: 3px;
    background: var(--color-line);
    position: relative;
    overflow: hidden;
  }

  .process__progress-bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 12%;
    background: var(--color-red);
    transition: width 0.15s linear;
  }

  .process__buttons {
    display: flex;
    gap: 0.6rem;
  }

  .process__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-line);
    background: #fff;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .process__arrow:hover {
    background: var(--color-red);
    border-color: var(--color-red);
    color: #fff;
  }

  .process__arrow:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  /* Mobile: horizontaler Swipe statt Pin-Scroll */
  @media (max-width: 56rem) {
    .process__stage {
      height: auto;
    }

    .process__viewport {
      position: static;
      height: auto;
      overflow: visible;
    }

    .process__track {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-block: 0.5rem 1.5rem;
    }

    .process__track::-webkit-scrollbar {
      display: none;
    }

    .process-card,
    .process__photo {
      scroll-snap-align: start;
      min-height: clamp(24rem, 70vw, 30rem);
    }

    .process__controls {
      padding-inline: var(--gutter);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process__stage {
      height: auto;
    }
    .process__viewport {
      position: static;
      height: auto;
      overflow-x: auto;
    }
    .process__track {
      transform: none !important;
    }
  }
</style>

<script>
  /**
   * Pinned Horizontal-Scroll mit sichtbarem Kopfbereich:
   *  - Der gesamte Sektions-Inhalt (Titel + Intro + Steps + Controls) liegt
   *    im Sticky-Viewport und klebt an der Navigation.
   *  - Vertikales Scrollen im Sticky-Zustand wird per Transform in
   *    horizontales Verschieben des Tracks übersetzt.
   */
  const isDesktop = () => window.matchMedia('(min-width: 56rem)').matches;
  const prefersReduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const stage = document.querySelector<HTMLElement>('[data-process-stage]');
  const viewport = document.querySelector<HTMLElement>('[data-process-viewport]');
  const track = document.querySelector<HTMLElement>('[data-process-track]');
  const progress = document.querySelector<HTMLElement>('[data-process-progress]');
  const prev = document.querySelector<HTMLButtonElement>('[data-process-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-process-next]');

  if (stage && viewport && track) {
    let maxScroll = 0;

    const measure = () => {
      if (!isDesktop() || prefersReduced()) {
        stage.style.height = 'auto';
        track.style.transform = 'translate3d(0,0,0)';
        maxScroll = 0;
        return;
      }
      maxScroll = track.scrollWidth - viewport.clientWidth;
      if (maxScroll < 0) maxScroll = 0;
      // Kleine Puffer-Halte-Zeit, damit der Endzustand ruhig „steht"
      // bevor die Sektion vertikal weiter scrollt.
      const holdPx = viewport.clientHeight * 0.25;
      stage.style.height = `${viewport.clientHeight + maxScroll + holdPx}px`;
      update();
    };

    // Startet den horizontalen Scroll bereits, bevor die Sektion sticky pinnt
    // (30 vh statt gleich mit dem CSS-Sticky-Wert 18 vh). Dadurch beginnt die
    // Bewegung schon während die Sektion in die Bildschirmmitte scrollt.
    const stickyOffset = () => window.innerHeight * 0.3;

    const update = () => {
      if (!isDesktop() || prefersReduced()) return;
      const rect = stage.getBoundingClientRect();
      const scrolled = Math.min(Math.max(stickyOffset() - rect.top, 0), maxScroll);
      track.style.transform = `translate3d(${-scrolled}px, 0, 0)`;
      const ratio = maxScroll === 0 ? 1 : scrolled / maxScroll;
      if (progress) progress.style.width = `${Math.max(12, Math.round(ratio * 100))}%`;
      if (prev) prev.disabled = ratio <= 0.001;
      if (next) next.disabled = ratio >= 0.999;
    };

    const stepDistance = () => {
      const card = track.querySelector<HTMLElement>('[data-process-card]');
      return (card?.offsetWidth ?? 480) + 20;
    };

    prev?.addEventListener('click', () => {
      window.scrollBy({ top: -stepDistance(), behavior: 'smooth' });
    });
    next?.addEventListener('click', () => {
      window.scrollBy({ top: stepDistance(), behavior: 'smooth' });
    });

    const mobilePrev = () => track.scrollBy({ left: -stepDistance(), behavior: 'smooth' });
    const mobileNext = () => track.scrollBy({ left: stepDistance(), behavior: 'smooth' });
    prev?.addEventListener('click', () => { if (!isDesktop()) mobilePrev(); });
    next?.addEventListener('click', () => { if (!isDesktop()) mobileNext(); });

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', measure);
    window.addEventListener('load', measure);
    measure();
  }
</script>
