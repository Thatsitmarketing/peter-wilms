---
import { processSteps } from '../../data/site';
---

<section class="section section--soft" id="ablauf" aria-labelledby="process-title">
  <div class="container">
    <span class="section__kicker" data-reveal>So arbeiten wir</span>
    <h2 class="section__title" id="process-title" data-reveal>
      Vom ersten Kontakt bis zur Abnahme
    </h2>
    <p class="section__intro" data-reveal>
      Klare Abläufe geben Auftraggebern Planungssicherheit. So läuft ein Projekt
      mit uns – Schritt für Schritt.
    </p>

    <ol class="process">
      <!-- Kein data-reveal auf den Schritten: sie haben eine eigene
           Opacity-Logik (Scroll-Hervorhebung via .is-active) -->
      {processSteps.map((step, index) => (
        <li class="process__step" data-process-step>
          <div class="process__marker" aria-hidden="true">
            <span class="process__num">{String(index + 1).padStart(2, '0')}</span>
            <span class="process__line"></span>
          </div>
          <div class="process__body">
            <h3 class="process__title">{step.title}</h3>
            <p class="process__text">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .process__step {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.5rem;
    /* Scroll-Hervorhebung: inaktive Schritte leicht zurückgenommen */
    opacity: 0.55;
    transition: opacity 0.4s ease;
  }

  .process__step.is-active {
    opacity: 1;
  }

  .process__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .process__num {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 2px solid var(--color-line);
    background: #fff;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--color-slate);
    transition: border-color 0.4s ease, color 0.4s ease, background-color 0.4s ease,
      transform 0.4s var(--ease-out);
  }

  .process__step.is-active .process__num {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
    transform: scale(1.06);
  }

  .process__line {
    flex: 1;
    width: 2px;
    min-height: 2.5rem;
    background: var(--color-line);
  }

  .process__step:last-child .process__line {
    display: none;
  }

  .process__body {
    padding-bottom: 2.5rem;
  }

  .process__title {
    font-size: 1.15rem;
    margin: 0.6rem 0 0.4rem;
  }

  .process__text {
    margin: 0;
    color: var(--color-slate);
    max-width: 65ch;
  }
</style>
