---
import { aboutPage } from '../../../data/site';

const { hero } = aboutPage;
---

<section class="about-hero" aria-labelledby="about-hero-title" data-about-hero>
  <!-- Riesiges „Über Uns"-Wasserzeichen im Hintergrund -->
  <p class="about-hero__watermark" aria-hidden="true">Über Uns</p>

  <div class="container about-hero__grid">
    <!-- Brücken-Crossfade: die kaputte Brücke liegt vorne und wird beim Scrollen
         zur sanierten Brücke überblendet. Sie kommt von links herein und ragt
         bewusst unten aus der Sektion heraus, sodass die Brücke ohne sichtbare
         Kante in den nächsten Abschnitt übergeht. -->
    <div class="about-hero__bridge" aria-hidden="true">
      <img
        class="about-hero__bridge-img about-hero__bridge-img--after"
        src="/bridges/bruecke-gepflegt.png"
        alt=""
        loading="eager"
        decoding="async"
      />
      <img
        class="about-hero__bridge-img about-hero__bridge-img--before"
        src="/bridges/bruecke-schaden.png"
        alt=""
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="about-hero__content">
      <span class="about-hero__kicker" data-reveal>{hero.kicker}</span>
      <h1 class="about-hero__title" id="about-hero-title" data-reveal style="--reveal-delay: 0.08s">
        {hero.title}
      </h1>
      <p class="about-hero__subline" data-reveal style="--reveal-delay: 0.16s">{hero.subline}</p>
    </div>
  </div>
</section>

<style>
  .about-hero {
    position: relative;
    background: #f5f5f5;
    color: var(--color-ink);
    /* Volle Bühne, aber ohne Abschluss-Padding unten, damit die Brücke
       nahtlos in den nächsten Abschnitt übergeht. */
    min-height: min(100svh, 52rem);
    padding-block: clamp(4rem, 8vw, 6.5rem) 0;
    overflow: hidden;
    isolation: isolate;
  }

  /* Wasserzeichen „Über Uns" – riesig, sehr blass, kein Auswahl-/Klick-Ziel */
  .about-hero__watermark {
    position: absolute;
    top: clamp(2.5rem, 6vw, 5rem);
    left: -1vw;
    right: -1vw;
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.85;
    font-size: clamp(6rem, 20vw, 20rem);
    color: transparent;
    -webkit-text-stroke: 1px rgba(15, 15, 15, 0.14);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    z-index: 0;
  }

  .about-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    /* Brücke links, Text rechts */
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    min-height: inherit;
  }

  .about-hero__content {
    position: relative;
    z-index: 2;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 6rem);
    max-width: 40rem;
  }

  .about-hero__kicker {
    display: inline-block;
    background: var(--color-red);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.35rem 0.9rem;
    margin-bottom: 1.25rem;
  }

  .about-hero__title {
    font-size: clamp(1.9rem, 4.5vw, 3.4rem);
    color: var(--color-ink);
    max-width: 22ch;
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .about-hero__subline {
    max-width: 52ch;
    margin: 0;
    color: var(--color-slate);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* Linke Spalte – Brücken-Ausschnitt kommt von links und läuft unten aus dem Container heraus */
  .about-hero__bridge {
    position: relative;
    height: 100%;
    min-height: clamp(24rem, 55vh, 38rem);
    margin-left: calc(var(--gutter, 1.5rem) * -1);
    align-self: stretch;
  }

  .about-hero__bridge-img {
    position: absolute;
    left: -6%;
    /* Nach unten aus der Sektion hinausragen, sodass die Brücke ohne
       sichtbare Kante in den nächsten Abschnitt übergeht. */
    bottom: -12%;
    width: 115%;
    max-width: none;
    height: auto;
    object-fit: contain;
    object-position: left bottom;
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.18));
    will-change: opacity;
  }

  .about-hero__bridge-img--after {
    /* Die sanierte Brücke liegt hinten – wird beim Scrollen sichtbar */
    z-index: 1;
  }

  .about-hero__bridge-img--before {
    /* Die kaputte Brücke liegt vorne – wird beim Scrollen ausgeblendet.
       --bridge-progress: 0 = ganz kaputt sichtbar, 1 = vollständig saniert. */
    z-index: 2;
    opacity: calc(1 - var(--bridge-progress, 0));
    transition: opacity 0.2s linear;
  }

  @media (max-width: 62rem) {
    .about-hero {
      min-height: auto;
      padding-block: clamp(3rem, 7vw, 5rem) 0;
    }

    .about-hero__grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 2rem;
    }

    .about-hero__content {
      padding-block: 0;
      max-width: 100%;
    }

    .about-hero__bridge {
      min-height: 22rem;
      margin-left: 0;
      margin-inline: calc(var(--gutter, 1.5rem) * -1);
    }

    .about-hero__bridge-img {
      left: 0;
      bottom: -8%;
      width: 100%;
    }

    .about-hero__watermark {
      font-size: clamp(4.5rem, 22vw, 12rem);
    }
  }
</style>

<script>
  /**
   * Scroll-Crossfade zwischen kaputter und sanierter Brücke:
   * Je weiter die About-Hero-Sektion in den Viewport gescrollt ist,
   * desto niedriger die Deckkraft der kaputten Brücke.
   * Fortschritt wird als CSS Custom Property --bridge-progress gesetzt.
   */
  const section = document.querySelector<HTMLElement>('[data-about-hero]');
  if (section) {
    const clamp = (v: number) => Math.min(1, Math.max(0, v));

    const update = () => {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const total = rect.height + vh;
      const scrolled = vh - rect.top;
      const progress = clamp(scrolled / total);
      // Schneller Crossfade: bereits nach ca. 10% Sichtbarkeit starten
      // und schon bei ~35% Fortschritt komplett saniert sein.
      const eased = clamp((progress - 0.1) / 0.25);
      section.style.setProperty('--bridge-progress', eased.toFixed(3));
    };

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
