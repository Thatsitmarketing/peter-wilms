---
import { aboutPage } from '../../../data/site';

const { hero } = aboutPage;
---

<section class="about-hero photo-placeholder" aria-labelledby="about-hero-title">
  <div class="about-hero__overlay" aria-hidden="true"></div>
  <div class="photo-placeholder__tag">
    <span>Bild-Platzhalter: Brückenbauwerk (Vollbild-Hintergrund)</span>
  </div>

  <div class="container about-hero__content">
    <span class="about-hero__kicker" data-reveal>{hero.kicker}</span>
    <h1 class="about-hero__title" data-reveal style="--reveal-delay: 0.08s">{hero.title}</h1>
    <p class="about-hero__subline" data-reveal style="--reveal-delay: 0.16s">{hero.subline}</p>
  </div>
</section>

<style>
  .about-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(34rem, 68svh);
    color: #fff;
    padding-block: clamp(5rem, 12vw, 8rem) clamp(3rem, 7vw, 4.5rem);
  }

  .about-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.2) 45%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .about-hero__content {
    position: relative;
    z-index: 2;
  }

  .about-hero__kicker {
    display: inline-block;
    background: var(--color-red);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.35rem 0.9rem;
    margin-bottom: 1.1rem;
  }

  .about-hero__title {
    font-size: clamp(2rem, 5vw, 3.75rem);
    color: #fff;
    max-width: 20ch;
    margin-bottom: 1rem;
  }

  .about-hero__subline {
    max-width: 60ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.92);
  }
</style>
