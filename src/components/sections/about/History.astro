---
import { aboutPage } from '../../../data/site';

const { history } = aboutPage;

/** Farbwelten rotieren: hell → dunkel → rot */
const themes = ['light', 'dark', 'red'] as const;
---

<section class="section section--soft history" id="geschichte" aria-labelledby="history-title">
  <div class="container history__grid">
    <!-- Linke Spalte: Kicker + Titel (sticky, damit sie während des Stackings sichtbar bleibt) -->
    <aside class="history__head">
      <span class="section__kicker" data-reveal>{history.kicker}</span>
      <h2 class="section__title" id="history-title" data-reveal style="--reveal-delay: 0.06s">
        {history.title}
      </h2>
    </aside>

    <!-- Rechte Spalte: Scroll-Stapel – jede Karte klebt beim Scrollen und die nächste
         schiebt sich mit leichtem Versatz darüber. -->
    <ol class="history__list">
      {history.milestones.map((item, index) => (
        <li
          class:list={['milestone', `milestone--${themes[index % themes.length]}`]}
          style={`--i: ${index};`}
        >
          <article class="milestone__card">
            <header class="milestone__header">
              <span class="milestone__year">{item.year}</span>
              <span class="milestone__label">{item.title}</span>
            </header>
            <p class="milestone__text">{item.text}</p>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .history__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .history__head {
    position: sticky;
    /* Sticky-Punkt weiter unten, damit oben noch Luft bleibt und
       Kopf + Karten mittig statt am Rand kleben. */
    top: 22vh;
    align-self: start;
  }

  .history .section__title {
    max-width: 18ch;
    margin-bottom: 0;
  }

  /* Der Stapel bekommt genug Raum, damit jede Karte ihren Scroll-Slot hat.
     Kompakte Distanz zwischen den Sticky-Punkten. */
  .history__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18vh;
    padding-bottom: 2rem;
  }

  .milestone {
    position: sticky;
    /* Sticky-Basis mittig im Viewport; jede Karte klebt etwas tiefer
       als die vorherige → sichtbarer Stapel-Effekt */
    top: calc(22vh + var(--i, 0) * 0.9rem);
    width: 100%;
  }

  /* Einzelne, flache Kachel – kein Shadow-/Akzent-Layer mehr */
  .milestone__card {
    padding: clamp(1.75rem, 3vw, 2.75rem) clamp(1.75rem, 3vw, 2.75rem);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
  }

  .milestone--light .milestone__card {
    background: #fff;
    color: var(--color-ink);
  }

  .milestone--dark .milestone__card {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .milestone--red .milestone__card {
    background: var(--color-red);
    color: #fff;
  }

  .milestone__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem clamp(1rem, 3vw, 2.5rem);
    margin-bottom: 0.9rem;
  }

  .milestone__year {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .milestone__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.1;
  }

  .milestone__text {
    margin: 0;
    line-height: 1.6;
    max-width: 58ch;
  }

  .milestone--light .milestone__text {
    color: var(--color-slate);
  }

  .milestone--dark .milestone__text {
    color: var(--color-on-dark-soft);
  }

  .milestone--red .milestone__text {
    color: rgba(255, 255, 255, 0.92);
  }

  @media (max-width: 62rem) {
    .history__grid {
      grid-template-columns: 1fr;
    }

    .history__head {
      position: static;
      margin-bottom: clamp(2rem, 4vw, 2.5rem);
    }
  }

  @media (max-width: 40rem) {
    .history__list {
      gap: 14vh;
    }
  }

  /* Reduced motion: klassische, statische Anordnung ohne Sticky-Stapel */
  @media (prefers-reduced-motion: reduce) {
    .history__list {
      gap: clamp(1.5rem, 3vw, 2.25rem);
      padding-bottom: 0;
    }

    .milestone {
      position: static;
    }
  }
</style>
