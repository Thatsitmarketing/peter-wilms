---
import { aboutPage } from '../../../data/site';

const { history } = aboutPage;
---

<section class="section section--soft history" id="geschichte" aria-labelledby="history-title">
  <div class="container">
    <div class="history__head">
      <span class="section__kicker" data-reveal>{history.kicker}</span>
      <h2 class="section__title" id="history-title" data-reveal style="--reveal-delay: 0.06s">
        {history.title}
      </h2>
    </div>

    <ol class="history__list">
      {history.milestones.map((item, index) => (
        <li class="milestone" data-reveal="left" style={`--reveal-delay: ${index * 0.05}s`}>
          <div class="milestone__year">{item.year}</div>
          <div class="milestone__body">
            <h3 class="milestone__title">{item.title}</h3>
            <p class="milestone__text">{item.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .history__head {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .history__list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* Durchgehende Zeitachse hinter den Jahreszahlen */
  .history__list::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 5.75rem;
    width: 2px;
    background: var(--color-line);
  }

  .milestone {
    position: relative;
    display: grid;
    grid-template-columns: 5.75rem minmax(0, 1fr);
    gap: 0 clamp(1.5rem, 3vw, 2.75rem);
    padding-block: 1.25rem;
  }

  .milestone__year {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-red);
    line-height: 1.6;
  }

  /* Punkt auf der Zeitachse */
  .milestone::before {
    content: '';
    position: absolute;
    top: 2rem;
    left: 5.75rem;
    width: 11px;
    height: 11px;
    background: var(--color-red);
    transform: translate(-4.5px, -50%);
    z-index: 1;
  }

  .milestone__title {
    font-size: 1.2rem;
    margin-bottom: 0.35rem;
  }

  .milestone__text {
    margin: 0;
    color: var(--color-slate);
    max-width: 62ch;
  }

  @media (max-width: 40rem) {
    .history__list::before {
      left: 5px;
    }

    .milestone {
      grid-template-columns: 1fr;
      padding-left: 1.75rem;
      gap: 0.25rem;
    }

    .milestone::before {
      top: 1.9rem;
      left: 5px;
    }
  }
</style>
