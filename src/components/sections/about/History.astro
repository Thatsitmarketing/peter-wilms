---
import { aboutPage } from '../../../data/site';

const { history } = aboutPage;
---

<section class="section section--soft history" id="geschichte" aria-labelledby="history-title">
  <div class="container">
    <div class="history__head">
      <span class="section__kicker" data-reveal>{history.kicker}</span>
      <h2 class="section__title" id="history-title" data-reveal style="--reveal-delay: 0.06s">
        {history.title}
      </h2>
    </div>

    <ol class="history__list">
      {history.milestones.map((item, index) => (
        <li
          class:list={[
            'milestone',
            index % 2 === 0 ? 'milestone--light' : 'milestone--dark',
          ]}
          data-reveal="up"
          style={`--reveal-delay: ${index * 0.05}s`}
        >
          <article class="milestone__card">
            <header class="milestone__header">
              <span class="milestone__year">{item.year}</span>
              <span class="milestone__label">{item.title}</span>
            </header>
            <p class="milestone__text">{item.text}</p>
          </article>
          <span class="milestone__shadow" aria-hidden="true"></span>
          <span class="milestone__accent" aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .history__head {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .history__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(2.25rem, 4vw, 3.25rem);
  }

  .milestone {
    position: relative;
    max-width: 46rem;
  }

  /* Abwechselnd links / rechts einrücken, damit ein "gestapelter" Rhythmus entsteht */
  .milestone:nth-child(even) {
    margin-left: auto;
  }

  /* Karte selbst */
  .milestone__card {
    position: relative;
    z-index: 2;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.75rem);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .milestone--light .milestone__card {
    background: #fff;
    color: var(--color-ink);
  }

  .milestone--dark .milestone__card {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .milestone__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem clamp(1rem, 3vw, 2.5rem);
    margin-bottom: 0.9rem;
  }

  .milestone__year {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .milestone__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1.1;
  }

  .milestone__text {
    margin: 0;
    line-height: 1.6;
    max-width: 58ch;
  }

  .milestone--light .milestone__text {
    color: var(--color-slate);
  }

  .milestone--dark .milestone__text {
    color: var(--color-on-dark-soft);
  }

  /* Schwarzer Schattenblock hinter der Karte */
  .milestone__shadow {
    position: absolute;
    left: 1.25rem;
    right: -1.25rem;
    bottom: -1.25rem;
    height: clamp(2rem, 4vw, 2.75rem);
    background: var(--color-dark);
    z-index: 1;
  }

  /* Roter Akzentstreifen unterhalb des Schattens */
  .milestone__accent {
    position: absolute;
    left: 2.5rem;
    right: -2.5rem;
    bottom: -2.25rem;
    height: 0.65rem;
    background: var(--color-red);
    z-index: 0;
  }

  /* Bei gespiegelten Karten den Schatten/Streifen entgegengesetzt versetzen */
  .milestone:nth-child(even) .milestone__shadow {
    left: -1.25rem;
    right: 1.25rem;
  }

  .milestone:nth-child(even) .milestone__accent {
    left: -2.5rem;
    right: 2.5rem;
  }

  @media (max-width: 56rem) {
    .milestone,
    .milestone:nth-child(even) {
      margin-left: 0;
      margin-right: 0;
      max-width: 100%;
    }

    .milestone__shadow,
    .milestone:nth-child(even) .milestone__shadow {
      left: 0.75rem;
      right: -0.75rem;
    }

    .milestone__accent,
    .milestone:nth-child(even) .milestone__accent {
      left: 1.5rem;
      right: -1.5rem;
    }
  }
</style>
