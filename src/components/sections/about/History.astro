---
import { aboutPage } from '../../../data/site';

const { history } = aboutPage;
---

<section class="section section--soft history" id="geschichte" aria-labelledby="history-title">
  <div class="container history__grid">
    <!-- Linke Spalte: Kicker + Titel (sticky, damit sie während des Scrollens sichtbar bleibt) -->
    <aside class="history__head">
      <span class="section__kicker" data-reveal>{history.kicker}</span>
      <h2 class="section__title" id="history-title" data-reveal style="--reveal-delay: 0.06s">
        {history.title}
      </h2>
    </aside>

    <!-- Rechte Spalte: vertikal gestapelte Meilenstein-Karten -->
    <ol class="history__list">
      {history.milestones.map((item, index) => (
        <li
          class:list={[
            'milestone',
            index % 2 === 0 ? 'milestone--light' : 'milestone--dark',
          ]}
          data-reveal="up"
          style={`--reveal-delay: ${index * 0.05}s`}
        >
          <article class="milestone__card">
            <header class="milestone__header">
              <span class="milestone__year">{item.year}</span>
              <span class="milestone__label">{item.title}</span>
            </header>
            <p class="milestone__text">{item.text}</p>
          </article>
          <span class="milestone__shadow" aria-hidden="true"></span>
          <span class="milestone__accent" aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .history__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .history__head {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .history .section__title {
    max-width: 18ch;
    margin-bottom: 0;
  }

  .history__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(2.25rem, 4vw, 3.25rem);
  }

  .milestone {
    position: relative;
    width: 100%;
  }

  /* Karte selbst */
  .milestone__card {
    position: relative;
    z-index: 2;
    padding: clamp(1.4rem, 2.6vw, 2.25rem) clamp(1.5rem, 2.8vw, 2.5rem);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .milestone--light .milestone__card {
    background: #fff;
    color: var(--color-ink);
  }

  .milestone--dark .milestone__card {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .milestone__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem clamp(1rem, 3vw, 2.5rem);
    margin-bottom: 0.9rem;
  }

  .milestone__year {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .milestone__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.1;
  }

  .milestone__text {
    margin: 0;
    line-height: 1.6;
    max-width: 58ch;
  }

  .milestone--light .milestone__text {
    color: var(--color-slate);
  }

  .milestone--dark .milestone__text {
    color: var(--color-on-dark-soft);
  }

  /* Schwarzer Schattenblock hinter jeder Karte */
  .milestone__shadow {
    position: absolute;
    left: 1.25rem;
    right: -1.25rem;
    bottom: -1.25rem;
    height: clamp(2rem, 4vw, 2.75rem);
    background: var(--color-dark);
    z-index: 1;
  }

  /* Roter Akzentstreifen unterhalb des Schattens */
  .milestone__accent {
    position: absolute;
    left: 2.5rem;
    right: -2.5rem;
    bottom: -2.25rem;
    height: 0.65rem;
    background: var(--color-red);
    z-index: 0;
  }

  @media (max-width: 62rem) {
    .history__grid {
      grid-template-columns: 1fr;
    }

    .history__head {
      position: static;
      margin-bottom: clamp(2rem, 4vw, 2.5rem);
    }
  }

  @media (max-width: 40rem) {
    .milestone__shadow {
      left: 0.75rem;
      right: -0.75rem;
    }

    .milestone__accent {
      left: 1.5rem;
      right: -1.5rem;
    }
  }
</style>
