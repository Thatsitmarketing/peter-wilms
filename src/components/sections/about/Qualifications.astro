---
import { aboutPage } from '../../../data/site';

const { qualifications } = aboutPage;
---

<section class="qualifications" id="qualifikationen" aria-labelledby="qualifications-title">
  <div class="qualifications__bg" aria-hidden="true"></div>

  <div class="container qualifications__inner">
    <!-- Linke Seite: sauberes 3er-Raster aus weißen Karten -->
    <ul class="qualifications__grid">
      {qualifications.items.map((item, index) => (
        <li
          class="qual-card"
          data-reveal
          style={`--reveal-delay: ${index * 0.06}s`}
        >
          <h3 class="qual-card__title">{item.title}</h3>
          {item.subtitle && <p class="qual-card__subtitle">{item.subtitle}</p>}
          <p class="qual-card__text">{item.text}</p>
        </li>
      ))}
    </ul>

    <!-- Rechte Seite: Kicker + Titel + Intro -->
    <div class="qualifications__head">
      <span class="qualifications__kicker" data-reveal>{qualifications.kicker}</span>
      <h2 class="qualifications__title" id="qualifications-title" data-reveal style="--reveal-delay: 0.06s">
        {qualifications.title}
      </h2>
      <p class="qualifications__intro" data-reveal style="--reveal-delay: 0.12s">{qualifications.intro}</p>
    </div>
  </div>
</section>

<style>
  .qualifications {
    position: relative;
    background: var(--color-red);
    color: #fff;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* Dezente Muster-/Fotoebene hinter dem Rot – wie im Referenzbild */
  .qualifications__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      repeating-linear-gradient(-30deg, rgba(255,255,255,0.05) 0 2px, transparent 2px 24px),
      radial-gradient(70rem 40rem at 20% 20%, rgba(255,255,255,0.08), transparent 60%),
      radial-gradient(50rem 30rem at 90% 80%, rgba(0,0,0,0.15), transparent 60%),
      linear-gradient(135deg, #d61a1d 0%, var(--color-red) 45%, #b81417 100%);
    opacity: 1;
  }

  .qualifications__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  /* -------- Karten-Raster – sauberes 3er-Grid, gleich hoch -------- */
  .qualifications__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }

  .qual-card {
    background: #fff;
    color: var(--color-ink);
    padding: clamp(1.25rem, 1.8vw, 1.75rem);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .qual-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.22);
  }

  .qual-card__title {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 1.5vw, 1.35rem);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  .qual-card__subtitle {
    margin: 0 0 0.9rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .qual-card__text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-slate);
  }

  /* -------- Rechte Textspalte -------- */
  .qualifications__head {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .qualifications__kicker {
    display: inline-block;
    background: var(--color-red);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.35rem 0.9rem;
    margin-bottom: 1.5rem;
    /* leicht abgehoben vom Rot dahinter */
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  .qualifications__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    line-height: 1.15;
    color: #fff;
    margin: 0 0 1.25rem;
    max-width: 18ch;
  }

  .qualifications__intro {
    margin: 0;
    color: rgba(255, 255, 255, 0.92);
    max-width: 40ch;
    font-size: 1rem;
    line-height: 1.65;
  }

  /* --------- Responsiv --------- */
  @media (max-width: 68rem) {
    .qualifications__inner {
      grid-template-columns: 1fr;
    }
    .qualifications__head {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 62rem) {
    .qualifications__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .qualifications__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qual-card:hover {
      transform: none;
    }
  }
</style>
