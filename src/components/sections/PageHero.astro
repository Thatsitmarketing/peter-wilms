---
interface Props {
  kicker: string;
  title: string;
  subline?: string;
  photoTag?: string;
}

const { kicker, title, subline, photoTag = 'Bild-Platzhalter' } = Astro.props;
---

<section class="page-hero photo-placeholder" aria-labelledby="page-hero-title">
  <div class="page-hero__overlay" aria-hidden="true"></div>
  <div class="photo-placeholder__tag">
    <span>{photoTag}</span>
  </div>

  <div class="container page-hero__content">
    <span class="page-hero__kicker" data-reveal>{kicker}</span>
    <h1 class="page-hero__title" id="page-hero-title" data-reveal style="--reveal-delay: 0.08s">
      {title}
    </h1>
    {subline && (
      <p class="page-hero__subline" data-reveal style="--reveal-delay: 0.16s">{subline}</p>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(30rem, 60svh);
    color: #fff;
    padding-block: clamp(5rem, 12vw, 8rem) clamp(3rem, 7vw, 4.5rem);
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.2) 45%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .page-hero__content {
    position: relative;
    z-index: 2;
  }

  .page-hero__kicker {
    display: inline-block;
    background: var(--color-red);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.35rem 0.9rem;
    margin-bottom: 1.1rem;
    color: #fff;
  }

  .page-hero__title {
    font-size: clamp(2rem, 5vw, 3.75rem);
    color: #fff;
    max-width: 24ch;
    margin-bottom: 1rem;
  }

  .page-hero__subline {
    max-width: 62ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.92);
  }
</style>
