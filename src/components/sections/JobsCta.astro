---
import { company, jobsSection } from '../../data/site';

const mailto = `mailto:${company.contact.email}?subject=${encodeURIComponent('Bewerbung bei der Peter Willms Bauunternehmung GmbH')}`;
---

<section class="jobs photo-placeholder" aria-labelledby="jobs-title">
  <div class="photo-placeholder__tag">
    <span>Bild-Platzhalter: Team auf der Baustelle (Vollbild-Hintergrund)</span>
  </div>

  <div class="container">
    <div class="jobs__panel" data-reveal="left">
      <h2 class="jobs__title" id="jobs-title">{jobsSection.title}</h2>
      <p class="jobs__text">{jobsSection.text}</p>
      <a href={mailto} class="btn btn--white">{jobsSection.ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .jobs {
    position: relative;
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .jobs__panel {
    position: relative;
    max-width: 26rem;
    padding: clamp(2rem, 4vw, 3rem);
    /* Rotes Overlay-Panel wie in der Referenz */
    background: linear-gradient(135deg, rgba(229, 30, 33, 0.96), rgba(180, 16, 19, 0.9));
    color: #fff;
  }

  .jobs__title {
    color: #fff;
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    margin-bottom: 1rem;
  }

  .jobs__text {
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 1.75rem;
  }
</style>
