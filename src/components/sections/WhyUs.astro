---
import MediaPlaceholder from '../MediaPlaceholder.astro';
import { whyUs, certifications } from '../../data/site';
---

<section class="section section--ink" id="warum-willms" aria-labelledby="whyus-title">
  <div class="container">
    <div class="whyus__grid">
      <div>
        <span class="section__kicker" data-reveal>Warum Willms</span>
        <h2 class="section__title" id="whyus-title" data-reveal>
          Ein Gewerk. Seit Jahrzehnten. Richtig gemacht.
        </h2>

        <div class="whyus__items">
          {whyUs.map((item, index) => (
            <div class="whyus__item" data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
              <span class="whyus__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="whyus__item-title">{item.title}</h3>
                <p class="whyus__item-text">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="whyus__aside" data-reveal="right">
        <MediaPlaceholder label="Kolonne bei der Betoninstandsetzung" ratio="3/4" />
        <div class="whyus__certs">
          <p class="whyus__certs-title">Qualifikationen im Haus</p>
          <ul class="whyus__certs-list">
            {certifications.map((cert) => (
              <li>
                <strong>{cert.name}</strong>
                <span>{cert.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .whyus__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .whyus__grid .section__title {
    color: #fff;
  }

  .whyus__items {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .whyus__item {
    display: flex;
    gap: 1.25rem;
  }

  .whyus__num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .whyus__item-title {
    font-size: 1.15rem;
    color: #fff;
    margin-bottom: 0.4rem;
  }

  .whyus__item-text {
    margin: 0;
    color: #b7c2cd;
    max-width: 55ch;
  }

  .whyus__aside {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .whyus__certs {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .whyus__certs-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .whyus__certs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .whyus__certs-list li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .whyus__certs-list strong {
    color: #fff;
  }

  .whyus__certs-list span {
    font-size: 0.85rem;
    color: #97a5b3;
  }

  @media (max-width: 56rem) {
    .whyus__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
