---
import { faq, faqSection } from '../../data/site';
---

<section class="section section--dark faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__aside">
      <p class="faq__kicker" data-reveal>{faqSection.kicker}</p>
      <h2 class="faq__title" id="faq-title" data-reveal style="--reveal-delay: 0.08s">
        {faqSection.title}
      </h2>
      <div data-reveal style="--reveal-delay: 0.16s">
        <a href="#kontakt" class="btn btn--red btn--small">{faqSection.ctaLabel}</a>
      </div>
    </div>

    <div class="faq__list">
      {faq.map((item, index) => (
        <!-- Reveal auf dem Wrapper – <details> hat eigene transition-Regeln -->
        <div data-reveal style={`--reveal-delay: ${index * 0.06}s`}>
        <details class="faq-item" data-faq>
          <summary class="faq-item__question">
            <span>{item.question}</span>
            <span class="faq-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <div class="faq-item__answer-wrap">
            <p class="faq-item__answer">{item.answer}</p>
          </div>
        </details>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  /* Große rote FAQ-Marke wie in der Referenz */
  .faq__kicker {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(3.5rem, 6vw, 5rem);
    line-height: 1;
    color: var(--color-red);
    margin: 0 0 1rem;
  }

  .faq__title {
    color: #fff;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 1.75rem;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .faq-item {
    background: var(--color-bg-soft);
    color: var(--color-ink);
    transition: box-shadow 0.25s ease;
  }

  .faq-item[open] {
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.4rem 1.6rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--color-ink);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-out), color 0.25s ease;
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(45deg);
    color: var(--color-red);
  }

  /* Sanfte Auf-/Zuklapp-Animation über grid-template-rows (JS steuert open) */
  .faq-item__answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s var(--ease-out);
  }

  .faq-item[open] .faq-item__answer-wrap {
    grid-template-rows: 1fr;
  }

  .faq-item__answer {
    overflow: hidden;
    margin: 0;
    padding: 0 1.6rem;
    color: var(--color-slate);
  }

  .faq-item[open] .faq-item__answer {
    padding-bottom: 1.4rem;
  }

  @media (max-width: 56rem) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  /**
   * <details> klappt nativ ohne Animation auf/zu. Für die sanfte Animation
   * steuern wir das open-Attribut selbst: Beim Schließen bleibt es gesetzt,
   * bis die CSS-Transition (grid-template-rows) abgeschlossen ist.
   */
  document.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach((details) => {
    const summary = details.querySelector('summary');
    const wrap = details.querySelector<HTMLElement>('.faq-item__answer-wrap');
    if (!summary || !wrap) return;

    summary.addEventListener('click', (event) => {
      event.preventDefault();

      if (details.open) {
        details.classList.add('is-closing');
        wrap.style.gridTemplateRows = '0fr';
        const onEnd = () => {
          details.open = false;
          details.classList.remove('is-closing');
          wrap.style.gridTemplateRows = '';
          wrap.removeEventListener('transitionend', onEnd);
        };
        wrap.addEventListener('transitionend', onEnd);
      } else {
        details.open = true;
      }
    });
  });
</script>
