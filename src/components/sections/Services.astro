---
import { services, servicesSection, servicesCta } from '../../data/site';
---

<section class="section section--dark services" id="leistungen" aria-labelledby="services-title">
  <div class="container">
    <h2 class="section__title" id="services-title" data-reveal>{servicesSection.title}</h2>
    <p class="section__intro" data-reveal style="--reveal-delay: 0.1s">{servicesSection.intro}</p>

    <div class="services__grid">
      {services.map((service, index) => (
        <!-- Reveal auf dem Wrapper, Hover-Transition auf der Karte -->
        <div data-reveal style={`--reveal-delay: ${(index % 4) * 0.08}s`}>
          <article class="service-card">
            <div class="service-card__media photo-placeholder" aria-hidden="true">
              <span class="service-card__media-tag">Bild-Platzhalter</span>
            </div>
            <div class="service-card__body">
              <h3 class="service-card__title">{service.title}</h3>
              <p class="service-card__text">{service.description}</p>
              <a class="service-card__cta" href={servicesCta.href} aria-label={`${servicesCta.label}: ${service.title}`}>
                <span>{servicesCta.label}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  @media (max-width: 68rem) {
    .services__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 52rem) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 32rem) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Hohe Bildkarten mit Titel unten links – wie in der Referenz */
  .service-card {
    position: relative;
    height: 100%;
    min-height: 26rem;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s ease;
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
  }

  .service-card__media {
    position: absolute;
    inset: 0;
    transition: transform 0.6s var(--ease-out);
  }

  .service-card:hover .service-card__media {
    transform: scale(1.04);
  }

  /* Dunkler Verlauf über dem (Platzhalter-)Bild für Lesbarkeit */
  .service-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.15) 60%);
  }

  .service-card__media-tag {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    border: 1px dashed rgba(255, 255, 255, 0.35);
    padding: 0.2rem 0.55rem;
    z-index: 1;
  }

  .service-card__body {
    position: relative;
    z-index: 2;
    padding: 1.5rem 1.4rem;
  }

  .service-card__title {
    font-size: 1.35rem;
    color: #fff;
    margin-bottom: 0;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  /* Beschreibung klappt beim Hover auf (Desktop), auf Touch immer sichtbar */
  .service-card__text {
    margin: 0;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.45s var(--ease-out), opacity 0.35s ease, margin-top 0.45s var(--ease-out);
  }

  .service-card:hover .service-card__text,
  .service-card:focus-within .service-card__text {
    max-height: 12rem;
    opacity: 1;
    margin-top: 0.6rem;
  }

  /* CTA-Button unter der Beschreibung – klappt zusammen mit Text ein */
  .service-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0;
    padding: 0.55rem 1rem;
    background: var(--color-red);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding-block: 0;
    transition: max-height 0.45s var(--ease-out), opacity 0.35s ease,
      margin-top 0.45s var(--ease-out), padding 0.35s ease, background-color 0.2s ease;
  }

  .service-card__cta svg {
    transition: transform 0.25s var(--ease-out);
  }

  .service-card__cta:hover,
  .service-card__cta:focus-visible {
    background: var(--color-red-dark);
  }

  .service-card__cta:hover svg,
  .service-card__cta:focus-visible svg {
    transform: translate(3px, -3px);
  }

  .service-card:hover .service-card__cta,
  .service-card:focus-within .service-card__cta {
    max-height: 3rem;
    opacity: 1;
    margin-top: 0.9rem;
    padding-block: 0.55rem;
  }

  @media (hover: none) {
    .service-card__text {
      max-height: none;
      opacity: 1;
      margin-top: 0.6rem;
    }

    .service-card__cta {
      max-height: 3rem;
      opacity: 1;
      margin-top: 0.9rem;
      padding-block: 0.55rem;
    }
  }
</style>
