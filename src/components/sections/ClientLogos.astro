---
import { clients } from '../../data/site';
---

<section class="clients" aria-label="Auftraggeber">
  <div class="container">
    <p class="clients__title" data-reveal>
      Vertraut von öffentlichen Auftraggebern und Bauunternehmen
    </p>
    <ul class="clients__list" data-reveal style="--reveal-delay: 0.12s">
      {clients.map((client) => (
        <li class="clients__logo" title={`Platzhalter – Logo ${client}`}>
          {client}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .clients {
    background: #fff;
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }

  .clients__title {
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink);
    margin-bottom: 2rem;
  }

  .clients__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 2.25rem;
  }

  /* Logo-Platzhalter: Textmarken in Rahmen, später durch <img> ersetzen */
  .clients__logo {
    display: grid;
    place-items: center;
    min-width: 9.5rem;
    padding: 0.9rem 1.5rem;
    border: 1px dashed #c4c4c4;
    color: #8a8a8a;
    font-weight: 600;
    letter-spacing: 0.03em;
    filter: grayscale(1);
    transition: filter 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .clients__logo:hover {
    filter: grayscale(0);
    color: var(--color-ink);
    border-color: var(--color-slate);
  }
</style>
