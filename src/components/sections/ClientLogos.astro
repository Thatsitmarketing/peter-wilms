---
import { clients } from '../../data/site';

interface Props {
  /** Überschrift über der Logoleiste */
  title?: string;
  /** true = graue Hintergrundfläche statt Weiß */
  soft?: boolean;
}

const {
  title = 'Vertraut von öffentlichen Auftraggebern und Bauunternehmen',
  soft = false,
} = Astro.props;
---

<section class:list={['clients', { 'clients--soft': soft }]} aria-label="Auftraggeber">
  <div class="container">
    <p class="clients__title" data-reveal>{title}</p>
    <ul class="clients__list">
      {clients.map((client, index) => (
        <li class="clients__item" data-reveal style={`--reveal-delay: ${index * 0.05}s`}>
          <img
            class="clients__logo"
            src={client.logo}
            alt={`Logo ${client.name}`}
            width="800"
            height="500"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .clients {
    background: #fff;
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }

  .clients--soft {
    background: var(--color-bg-soft);
  }

  .clients__title {
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink);
    margin-bottom: 2.25rem;
  }

  /* Flex statt Grid: eine unvollständige letzte Reihe bleibt so zentriert */
  .clients__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 3vw, 2.5rem) clamp(1.5rem, 4vw, 3.5rem);
  }

  /* Feste Spurbreite – ein „width: 100%“ auf auto-breiten Flex-Items kollabiert */
  .clients__item {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: clamp(7.5rem, 11vw, 10.5rem);
  }

  /* Logos zurückhaltend in Graustufen, beim Hover in Originalfarbe */
  .clients__logo {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
    transition: filter 0.25s ease, opacity 0.25s ease, transform 0.25s var(--ease-out);
  }

  .clients__item:hover .clients__logo {
    filter: grayscale(0);
    opacity: 1;
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .clients__item:hover .clients__logo {
      transform: none;
    }
  }
</style>
