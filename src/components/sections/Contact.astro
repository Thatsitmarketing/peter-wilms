---
import { contactSection, company } from '../../data/site';

const { address, contact } = company;
---

<section class="contact" id="kontakt" aria-labelledby="contact-title">
  <div class="contact__bg" aria-hidden="true"></div>

  <div class="container contact__grid">
    <!-- Linke Spalte: Ansprache, Adresse, Telefon, E-Mail, Öffnungszeiten -->
    <div class="contact__info" data-reveal>
      <p class="contact__kicker">Kontaktieren Sie uns</p>
      <h2 class="contact__title" id="contact-title">Wir sind für Sie da</h2>
      <p class="contact__lead">{contactSection.text}</p>

      <dl class="contact__meta">
        <div class="contact__block">
          <dt>Unser Standort</dt>
          <dd>
            {address.street}<br />
            {address.zip} {address.city}<br />
            {address.region}
          </dd>
        </div>

        <div class="contact__block">
          <dt>Telefon</dt>
          <dd>
            <a href={`tel:${contact.phoneCentral.replace(/\s/g, '')}`}>{contact.phoneCentralDisplay}</a><br />
            <a href={`tel:${contact.mobile.replace(/\s/g, '')}`}>{contact.mobileDisplay}</a>
          </dd>
        </div>

        <div class="contact__block">
          <dt>E-Mail</dt>
          <dd>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </dd>
        </div>

        <div class="contact__block">
          <dt>Öffnungszeiten</dt>
          <dd>
            <strong>Mo–Fr:</strong> 08:00 – 17:00 Uhr<br />
            <strong>Sa &amp; So:</strong> Geschlossen
          </dd>
        </div>
      </dl>
    </div>

    <!-- Mittlere Spalte: weißes Formular-Panel -->
    <form class="contact__form" data-contact-form novalidate data-reveal="right">
      <h3 class="contact__form-title">Kontakt</h3>

      <div class="form-field">
        <label for="cf-name">Vor &amp; Nachname *</label>
        <input type="text" id="cf-name" name="name" required autocomplete="name" />
      </div>

      <div class="form-field">
        <label for="cf-email">E-Mail *</label>
        <input type="email" id="cf-email" name="email" required autocomplete="email" />
      </div>

      <div class="form-field">
        <label for="cf-subject">Betreff *</label>
        <input type="text" id="cf-subject" name="subject" required />
      </div>

      <div class="form-field">
        <label for="cf-message">Nachricht</label>
        <textarea id="cf-message" name="message" rows="2"></textarea>
      </div>

      <!-- Honeypot gegen Spam-Bots: für Menschen unsichtbar, bleibt leer -->
      <div class="form-field form-field--hp" aria-hidden="true">
        <label for="cf-website">Website</label>
        <input type="text" id="cf-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form-field form-field--consent">
        <p class="form-field__consent-label">Einverständniserklärung *</p>
        <label>
          <input type="checkbox" id="cf-privacy" name="privacy" required />
          <span>
            Ich stimme zu, dass meine Angaben und Daten zur Beantwortung meiner Anfrage
            gemäß der <a href="/datenschutz">Datenschutzerklärung</a> verarbeitet werden.
            Meine Einwilligung kann ich jederzeit per E-Mail an
            <a href={`mailto:${contact.email}`}>{contact.email}</a> widerrufen.
          </span>
        </label>
      </div>

      <button type="submit" class="contact__submit">
        <span>Absenden</span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </button>

      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>

    <!-- Rechte Spalte: Bild-Platzhalter neben dem Formular -->
    <div class="contact__photo photo-placeholder" role="img" aria-label="Platzhalter – Kontaktbild" data-reveal="right" style="--reveal-delay: 0.1s">
      <div class="photo-placeholder__tag"><span>Foto: Kontakt</span></div>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    /* Section soll auf Desktop ca. 60 vh hoch sein – vertikale Polster
       schlanker als die anderen Sektionen. */
    padding-block: clamp(1.5rem, 2.5vw, 2.25rem);
    min-height: 60vh;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  /* Roter Hintergrund + dezente Weltkarten-Punkte (weiß, sehr transparent).
     Die Karte ist als radialer Punkt-Raster im Hintergrund gebacken. */
  .contact__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at center, rgba(255, 255, 255, 0.18) 1.1px, transparent 1.4px) 0 0/22px 22px,
      radial-gradient(1200px 500px at 80% 30%, rgba(255, 255, 255, 0.08), transparent 60%),
      radial-gradient(900px 500px at 15% 90%, rgba(0, 0, 0, 0.2), transparent 60%),
      linear-gradient(135deg, #d61a1d 0%, var(--color-red) 45%, #b81417 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 55%, #000 40%, rgba(0,0,0,0.4) 75%, transparent 100%);
            mask-image: radial-gradient(ellipse 80% 60% at 50% 55%, #000 40%, rgba(0,0,0,0.4) 75%, transparent 100%);
  }

  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(135deg, #d61a1d 0%, var(--color-red) 45%, #b81417 100%);
  }

  .contact__grid {
    display: grid;
    /* Info links, Formular in der Mitte weiter links gerückt, Bild rechts.
       Formular-Spalte etwas breiter, damit der Consent-Text nicht so stark
       umbricht – das drückt die Gesamthöhe der Section. */
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.05fr) minmax(0, 0.85fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: stretch;
    width: 100%;
  }

  /* --- Linke Spalte --- */
  .contact__kicker {
    margin: 0 0 0.6rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .contact__title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.1;
    color: #fff;
    margin: 0 0 0.85rem;
  }

  .contact__lead {
    max-width: 32rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.55;
    font-size: 0.95rem;
  }

  /* Meta kompakt: die vier Blöcke rücken näher aneinander, damit
     Telefon und Öffnungszeiten dicht bei Standort und E-Mail sitzen. */
  .contact__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 1.5rem;
    margin: 0;
  }

  .contact__block dt {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
    margin-bottom: 0.3rem;
  }

  .contact__block dd {
    margin: 0;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.88rem;
  }

  .contact__block a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    transition: border-color 0.2s ease;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  /* E-Mail-Block darf sich über beide Spalten strecken, damit lange
     Adressen nicht in die Öffnungszeiten-Spalte laufen. */
  .contact__block--wide {
    grid-column: 1 / -1;
  }

  .contact__block a:hover {
    border-color: #fff;
  }

  /* --- Mittlere Spalte: kompaktes weißes Formular --- */
  .contact__form {
    background: #fff;
    color: var(--color-ink);
    padding: clamp(1rem, 1.6vw, 1.4rem) clamp(1.1rem, 1.8vw, 1.5rem);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    width: 100%;
    margin: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
  }

  /* --- Rechte Spalte: Bild-Platzhalter --- */
  .contact__photo {
    align-self: stretch;
    min-height: 100%;
  }

  .contact__form-title {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.6vw, 1.45rem);
    margin: 0 0 0.6rem;
    color: var(--color-ink);
  }

  .form-field {
    margin-bottom: 0.4rem;
  }

  .form-field label {
    display: block;
    font-size: 0.8rem;
    color: var(--color-slate);
    margin-bottom: 0.2rem;
  }

  .form-field input[type='text'],
  .form-field input[type='email'],
  .form-field textarea {
    width: 100%;
    padding: 0.4rem 0;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    transition: border-color 0.2s ease;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--color-red);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 2.25rem;
    max-height: 6rem;
  }

  .form-field--hp {
    position: absolute;
    left: -9999px;
    top: auto;
  }

  .form-field--consent {
    margin-top: 0.35rem;
  }

  .form-field__consent-label {
    margin: 0 0 0.25rem;
    font-size: 0.78rem;
    color: var(--color-slate);
  }

  .form-field--consent > label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem;
    align-items: start;
    margin: 0;
    color: var(--color-slate);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .form-field--consent input {
    margin-top: 0.15rem;
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-red);
  }

  .form-field--consent a {
    color: var(--color-red);
  }

  .contact__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
    align-self: flex-start;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-red);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-bottom: 1px solid var(--color-red);
    padding-bottom: 0.35rem;
    transition: color 0.2s ease, border-color 0.2s ease, gap 0.2s ease;
  }

  .contact__submit:hover {
    color: var(--color-red-dark, #b81417);
    gap: 0.9rem;
  }

  .form-status {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    min-height: 1.4em;
    color: var(--color-slate);
  }

  .form-status.is-success {
    color: #157a3a;
  }

  .form-status.is-error {
    color: #b81417;
  }

  @media (max-width: 78rem) {
    .contact__grid {
      /* Auf mittleren Viewports Info + Formular oben, Bild darunter. */
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    }

    .contact__photo {
      grid-column: 1 / -1;
      min-height: 14rem;
    }
  }

  @media (max-width: 62rem) {
    .contact {
      min-height: 0;
      display: block;
    }

    .contact__grid {
      grid-template-columns: 1fr;
    }

    .contact__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact__form {
      max-width: none;
    }
  }

  @media (max-width: 40rem) {
    .contact__meta {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  function setStatus(message: string, type: 'success' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('is-success', type === 'success');
    status.classList.toggle('is-error', type === 'error');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    setStatus('Nachricht wird gesendet …', 'success');

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      form.reset();
      setStatus('Vielen Dank! Ihre Nachricht wurde übermittelt. Wir melden uns kurzfristig.', 'success');
    } catch {
      setStatus(
        'Die Nachricht konnte nicht gesendet werden. Bitte kontaktieren Sie uns telefonisch oder per E-Mail.',
        'error'
      );
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
