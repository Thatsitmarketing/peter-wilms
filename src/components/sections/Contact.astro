---
import { contactSection } from '../../data/site';
---

<section class="contact photo-placeholder" id="kontakt" aria-labelledby="contact-title">
  <div class="contact__tint" aria-hidden="true"></div>
  <div class="photo-placeholder__tag">
    <span>Bild-Platzhalter: Baustellenfoto mit rotem Overlay (Vollbild-Hintergrund)</span>
  </div>

  <div class="container">
    <form class="contact__panel" data-contact-form novalidate data-reveal="left">
      <h2 class="contact__title" id="contact-title">{contactSection.title}</h2>
      <p class="contact__text">{contactSection.text}</p>

      <div class="form-field">
        <label for="cf-name">Dein Name *</label>
        <input type="text" id="cf-name" name="name" required autocomplete="name" />
      </div>

      <div class="form-field">
        <label for="cf-email">Deine E-Mail-Adresse *</label>
        <input type="email" id="cf-email" name="email" required autocomplete="email" />
      </div>

      <div class="form-field">
        <label for="cf-subject">Betreff *</label>
        <input type="text" id="cf-subject" name="subject" required />
      </div>

      <div class="form-field">
        <label for="cf-message">Deine Nachricht (optional)</label>
        <textarea id="cf-message" name="message" rows="6"></textarea>
      </div>

      <!-- Honeypot gegen Spam-Bots: für Menschen unsichtbar, bleibt leer -->
      <div class="form-field form-field--hp" aria-hidden="true">
        <label for="cf-website">Website</label>
        <input type="text" id="cf-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form-field form-field--consent">
        <input type="checkbox" id="cf-privacy" name="privacy" required />
        <label for="cf-privacy">
          Ich habe die <a href="/datenschutz">Datenschutzerklärung</a> zur Kenntnis genommen
          und bin damit einverstanden, dass meine Angaben zur Bearbeitung der Anfrage
          gespeichert werden. *
        </label>
      </div>

      <p class="form-note">
        * Pflichtfelder. Ihre Daten werden ausschließlich zur Bearbeitung Ihrer Anfrage verwendet.
      </p>

      <button type="submit" class="btn btn--red">Senden</button>

      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding-block: clamp(4rem, 8vw, 6.5rem);
  }

  /* Rotes Overlay über dem Hintergrundfoto – wie in der Referenz */
  .contact__tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(229, 30, 33, 0.85), rgba(190, 18, 21, 0.82));
    mix-blend-mode: normal;
  }

  .contact__panel {
    position: relative;
    z-index: 2;
    max-width: 34rem;
    background: var(--color-dark);
    color: var(--color-on-dark);
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  .contact__title {
    color: #fff;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 0.5rem;
  }

  .contact__text {
    color: var(--color-on-dark-soft);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
  }

  .form-field {
    margin-bottom: 1.15rem;
  }

  .form-field label {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
    color: #fff;
  }

  .form-field input[type='text'],
  .form-field input[type='email'],
  .form-field textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 4px;
    font: inherit;
    color: var(--color-ink);
    background: #fff;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--color-red);
    box-shadow: 0 0 0 3px rgba(229, 30, 33, 0.35);
  }

  .form-field textarea {
    resize: vertical;
  }

  /* Honeypot unsichtbar positionieren (nicht display:none – Bots erkennen das) */
  .form-field--hp {
    position: absolute;
    left: -9999px;
    top: auto;
  }

  .form-field--consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
  }

  .form-field--consent input {
    margin-top: 0.3rem;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-red);
  }

  .form-field--consent label {
    font-weight: 400;
    font-size: 0.83rem;
    color: var(--color-on-dark-soft);
    margin: 0;
  }

  .form-field--consent a {
    color: #fff;
  }

  .form-note {
    font-size: 0.75rem;
    color: var(--color-on-dark-soft);
    margin-bottom: 1.4rem;
  }

  .form-status {
    margin: 1rem 0 0;
    font-size: 0.92rem;
    font-weight: 600;
    min-height: 1.4em;
  }

  .form-status.is-success {
    color: #7ede9c;
  }

  .form-status.is-error {
    color: #ffb3b4;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  function setStatus(message: string, type: 'success' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('is-success', type === 'success');
    status.classList.toggle('is-error', type === 'error');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    setStatus('Nachricht wird gesendet …', 'success');

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      form.reset();
      setStatus('Vielen Dank! Ihre Nachricht wurde übermittelt. Wir melden uns kurzfristig.', 'success');
    } catch {
      setStatus(
        'Die Nachricht konnte nicht gesendet werden. Bitte kontaktieren Sie uns telefonisch oder per E-Mail.',
        'error'
      );
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
