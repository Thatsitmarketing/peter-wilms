---
import { contactSection, company } from '../../data/site';

const { address, contact } = company;
---

<section class="contact" id="kontakt" aria-labelledby="contact-title">
  <div class="contact__bg" aria-hidden="true"></div>

  <div class="container contact__grid">
    <!-- Linke Spalte: Ansprache, Adresse, Telefon, E-Mail, Öffnungszeiten -->
    <div class="contact__info" data-reveal>
      <p class="contact__kicker">Kontaktieren Sie uns</p>
      <h2 class="contact__title" id="contact-title">Wir sind für Sie da</h2>
      <p class="contact__lead">{contactSection.text}</p>

      <dl class="contact__meta">
        <div class="contact__block">
          <dt>Unser Standort</dt>
          <dd>
            {address.street}<br />
            {address.zip} {address.city}<br />
            {address.region}
          </dd>
        </div>

        <div class="contact__block">
          <dt>Telefon</dt>
          <dd>
            <a href={`tel:${contact.phoneCentral.replace(/\s/g, '')}`}>{contact.phoneCentralDisplay}</a><br />
            <a href={`tel:${contact.mobile.replace(/\s/g, '')}`}>{contact.mobileDisplay}</a>
          </dd>
        </div>

        <div class="contact__block">
          <dt>E-Mail</dt>
          <dd>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </dd>
        </div>

        <div class="contact__block">
          <dt>Öffnungszeiten</dt>
          <dd>
            <strong>Montag bis Freitag:</strong> 08:00 – 17:00 Uhr<br />
            <strong>Samstag &amp; Sonntag:</strong> Geschlossen
          </dd>
        </div>
      </dl>
    </div>

    <!-- Rechte Spalte: weißes Formular-Panel -->
    <form class="contact__form" data-contact-form novalidate data-reveal="right">
      <h3 class="contact__form-title">Kontakt</h3>

      <div class="form-field">
        <label for="cf-name">Vor &amp; Nachname *</label>
        <input type="text" id="cf-name" name="name" required autocomplete="name" />
      </div>

      <div class="form-field">
        <label for="cf-email">E-Mail *</label>
        <input type="email" id="cf-email" name="email" required autocomplete="email" />
      </div>

      <div class="form-field">
        <label for="cf-subject">Betreff *</label>
        <input type="text" id="cf-subject" name="subject" required />
      </div>

      <div class="form-field">
        <label for="cf-message">Nachricht</label>
        <textarea id="cf-message" name="message" rows="5"></textarea>
      </div>

      <!-- Honeypot gegen Spam-Bots: für Menschen unsichtbar, bleibt leer -->
      <div class="form-field form-field--hp" aria-hidden="true">
        <label for="cf-website">Website</label>
        <input type="text" id="cf-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form-field form-field--consent">
        <p class="form-field__consent-label">Einverständniserklärung *</p>
        <label>
          <input type="checkbox" id="cf-privacy" name="privacy" required />
          <span>
            Ich stimme zu, dass meine Angaben und Daten zur Beantwortung meiner Anfrage
            gemäß der <a href="/datenschutz">Datenschutzerklärung</a> verarbeitet werden.
            Meine Einwilligung kann ich jederzeit per E-Mail an
            <a href={`mailto:${contact.email}`}>{contact.email}</a> widerrufen.
          </span>
        </label>
      </div>

      <button type="submit" class="contact__submit">
        <span>Absenden</span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </button>

      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  /* Roter Hintergrund + dezente Weltkarten-Punkte (weiß, sehr transparent).
     Die Karte ist als radialer Punkt-Raster im Hintergrund gebacken. */
  .contact__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      /* Weltkarten-Punkte: gleichmäßiges Raster in Weiß mit sehr geringer Opazität */
      radial-gradient(circle at center, rgba(255, 255, 255, 0.18) 1.1px, transparent 1.4px) 0 0/22px 22px,
      radial-gradient(1200px 500px at 80% 30%, rgba(255, 255, 255, 0.08), transparent 60%),
      radial-gradient(900px 500px at 15% 90%, rgba(0, 0, 0, 0.2), transparent 60%),
      linear-gradient(135deg, #d61a1d 0%, var(--color-red) 45%, #b81417 100%);
    /* Ovaler Kartenausschnitt: Punkte werden über Maske weich ausgeblendet an den Rändern */
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 55%, #000 40%, rgba(0,0,0,0.4) 75%, transparent 100%);
            mask-image: radial-gradient(ellipse 80% 60% at 50% 55%, #000 40%, rgba(0,0,0,0.4) 75%, transparent 100%);
  }

  /* Ein zweiter Layer sorgt dafür, dass das Rot ohne Maske voll deckt (die
     Maske oben trifft nur den Punkte-Layer). */
  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(135deg, #d61a1d 0%, var(--color-red) 45%, #b81417 100%);
  }

  /* Weltkarten-Overlay aus feinen weißen Punkten */
  .contact__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.28) 1px, transparent 1.4px);
    background-size: 14px 14px;
    background-position: 0 0;
    /* Weltkarten-Silhouette als Maske (SVG mit vereinfachten Kontinenten) */
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 500' preserveAspectRatio='xMidYMid meet'><g fill='black'><path d='M150,120 q30,-30 70,-25 q40,5 60,25 q30,20 50,15 q40,-5 60,20 q20,25 -10,45 q-30,20 -60,15 q-40,-5 -70,10 q-30,15 -60,5 q-40,-10 -50,-40 q-10,-30 10,-70 z'/><path d='M180,220 q40,-15 80,-5 q50,10 40,55 q-10,50 -60,60 q-50,10 -70,-30 q-20,-40 10,-80 z'/><path d='M450,110 q60,-30 130,-20 q80,10 130,40 q60,30 40,80 q-20,50 -100,60 q-90,10 -160,-10 q-70,-20 -70,-70 q0,-50 30,-80 z'/><path d='M480,240 q50,-20 100,-15 q60,10 80,50 q20,40 -30,60 q-50,20 -100,10 q-60,-10 -70,-50 q-10,-40 20,-55 z'/><path d='M720,80 q40,-20 90,-15 q60,5 70,40 q10,35 -30,55 q-40,20 -90,10 q-60,-10 -60,-45 q0,-35 20,-45 z'/><path d='M780,220 q30,-15 70,-10 q50,10 50,50 q0,40 -50,50 q-50,10 -80,-20 q-30,-30 10,-70 z'/><path d='M100,340 q40,-20 90,-10 q60,10 60,50 q0,40 -60,50 q-70,10 -100,-20 q-30,-30 10,-70 z'/></g></svg>");
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 500' preserveAspectRatio='xMidYMid meet'><g fill='black'><path d='M150,120 q30,-30 70,-25 q40,5 60,25 q30,20 50,15 q40,-5 60,20 q20,25 -10,45 q-30,20 -60,15 q-40,-5 -70,10 q-30,15 -60,5 q-40,-10 -50,-40 q-10,-30 10,-70 z'/><path d='M180,220 q40,-15 80,-5 q50,10 40,55 q-10,50 -60,60 q-50,10 -70,-30 q-20,-40 10,-80 z'/><path d='M450,110 q60,-30 130,-20 q80,10 130,40 q60,30 40,80 q-20,50 -100,60 q-90,10 -160,-10 q-70,-20 -70,-70 q0,-50 30,-80 z'/><path d='M480,240 q50,-20 100,-15 q60,10 80,50 q20,40 -30,60 q-50,20 -100,10 q-60,-10 -70,-50 q-10,-40 20,-55 z'/><path d='M720,80 q40,-20 90,-15 q60,5 70,40 q10,35 -30,55 q-40,20 -90,10 q-60,-10 -60,-45 q0,-35 20,-45 z'/><path d='M780,220 q30,-15 70,-10 q50,10 50,50 q0,40 -50,50 q-50,10 -80,-20 q-30,-30 10,-70 z'/><path d='M100,340 q40,-20 90,-10 q60,10 60,50 q0,40 -60,50 q-70,10 -100,-20 q-30,-30 10,-70 z'/></g></svg>");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: 92% auto;
    mask-size: 92% auto;
    opacity: 0.9;
    pointer-events: none;
  }

  .contact__grid {
    display: grid;
    /* Linke Spalte deutlich breiter, rechte Formular-Spalte schmaler */
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.85fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  /* --- Linke Spalte --- */
  .contact__kicker {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .contact__title {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.1;
    color: #fff;
    margin: 0 0 1.25rem;
  }

  .contact__lead {
    max-width: 42rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    line-height: 1.7;
  }

  .contact__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3rem);
    margin: 0;
  }

  .contact__block dt {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: #fff;
    margin-bottom: 0.6rem;
  }

  .contact__block dd {
    margin: 0;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
  }

  .contact__block a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    transition: border-color 0.2s ease;
  }

  .contact__block a:hover {
    border-color: #fff;
  }

  /* --- Rechte Spalte: weißes Formular, schmaler und leicht nach links geführt --- */
  .contact__form {
    background: #fff;
    color: var(--color-ink);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    /* Etwas schmaler als die Grid-Zelle und leicht nach links versetzt */
    max-width: 26rem;
    margin-left: 0;
    margin-right: auto;
  }

  .contact__form-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.8vw, 2rem);
    margin: 0 0 1.5rem;
    color: var(--color-ink);
  }

  .form-field {
    margin-bottom: 1.15rem;
  }

  .form-field label {
    display: block;
    font-size: 0.85rem;
    color: var(--color-slate);
    margin-bottom: 0.35rem;
  }

  .form-field input[type='text'],
  .form-field input[type='email'],
  .form-field textarea {
    width: 100%;
    padding: 0.55rem 0;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    transition: border-color 0.2s ease;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--color-red);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 5rem;
  }

  .form-field--hp {
    position: absolute;
    left: -9999px;
    top: auto;
  }

  .form-field--consent {
    margin-top: 0.5rem;
  }

  .form-field__consent-label {
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    color: var(--color-slate);
  }

  .form-field--consent > label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
    margin: 0;
    color: var(--color-slate);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .form-field--consent input {
    margin-top: 0.15rem;
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-red);
  }

  .form-field--consent a {
    color: var(--color-red);
  }

  .contact__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-red);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-bottom: 1px solid var(--color-red);
    padding-bottom: 0.35rem;
    transition: color 0.2s ease, border-color 0.2s ease, gap 0.2s ease;
  }

  .contact__submit:hover {
    color: var(--color-red-dark, #b81417);
    gap: 0.9rem;
  }

  .form-status {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    min-height: 1.4em;
    color: var(--color-slate);
  }

  .form-status.is-success {
    color: #157a3a;
  }

  .form-status.is-error {
    color: #b81417;
  }

  @media (max-width: 62rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }

    .contact__meta {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  function setStatus(message: string, type: 'success' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('is-success', type === 'success');
    status.classList.toggle('is-error', type === 'error');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    setStatus('Nachricht wird gesendet …', 'success');

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      form.reset();
      setStatus('Vielen Dank! Ihre Nachricht wurde übermittelt. Wir melden uns kurzfristig.', 'success');
    } catch {
      setStatus(
        'Die Nachricht konnte nicht gesendet werden. Bitte kontaktieren Sie uns telefonisch oder per E-Mail.',
        'error'
      );
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
