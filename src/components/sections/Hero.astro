---
import MediaPlaceholder from '../MediaPlaceholder.astro';
import { company } from '../../data/site';
---

<section class="hero" aria-label="Einführung">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="hero__kicker" data-reveal>
        <span class="hero__kicker-line" aria-hidden="true"></span>
        Spezialisiert seit {company.since}
      </p>
      <h1 class="hero__title" data-reveal style="--reveal-delay: 0.1s">
        Brücken- und Bauwerks&shy;instandsetzung mit System
      </h1>
      <p class="hero__text" data-reveal style="--reveal-delay: 0.2s">
        Die {company.name} saniert Brücken und Ingenieurbauwerke in ganz
        Nordrhein-Westfalen – für öffentliche Auftraggeber, Bauunternehmen und
        Ingenieurbüros. Qualifiziert, termintreu und mit Verantwortung für jedes Detail.
      </p>
      <div class="hero__actions" data-reveal style="--reveal-delay: 0.3s">
        <a href="#kontakt" class="btn btn--primary">Projekt anfragen</a>
        <a href="#leistungen" class="btn btn--ghost">Unsere Leistungen</a>
      </div>
    </div>

    <div class="hero__media" data-reveal="right" style="--reveal-delay: 0.2s">
      <MediaPlaceholder
        label="Brückenbaustelle / Imagefilm der Willms Bauunternehmung"
        type="video"
        ratio="4/3"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      linear-gradient(135deg, rgba(22, 33, 44, 0.97), rgba(36, 49, 63, 0.92)),
      repeating-linear-gradient(-45deg, #1a2632, #1a2632 60px, #1e2b38 60px, #1e2b38 120px);
    color: var(--color-on-ink);
    padding-block: clamp(4rem, 10vw, 7.5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .hero__kicker-line {
    display: inline-block;
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.4rem);
    color: #fff;
    margin-bottom: 1.25rem;
  }

  .hero__text {
    font-size: 1.1rem;
    color: #b7c2cd;
    max-width: 54ch;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
