---
import { hero, stats } from '../../data/site';
---

<section class="hero photo-placeholder" aria-label="Einführung">
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="photo-placeholder__tag">
    <span>Bild-Platzhalter: Baustellenfoto (Vollbild-Hintergrund)</span>
  </div>

  <div class="container hero__content">
    <div class="hero__main">
      <p class="hero__badge" data-reveal>{hero.badge}</p>
      <h1 class="hero__title" data-reveal style="--reveal-delay: 0.08s">{hero.title}</h1>
      <p class="hero__subline" data-reveal style="--reveal-delay: 0.16s">{hero.subline}</p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 0.24s">
        <a href={hero.ctaPrimary.href} class="btn btn--red">{hero.ctaPrimary.label}</a>
        <a href={hero.ctaSecondary.href} class="btn btn--white">{hero.ctaSecondary.label}</a>
      </div>

      <dl class="hero__stats" data-reveal style="--reveal-delay: 0.32s">
        {stats.map((stat) => (
          <div class="hero__stat">
            <dd>
              <span data-counter data-target={stat.value}>0</span>{stat.suffix}
            </dd>
            <dt>{stat.label}</dt>
          </div>
        ))}
      </dl>
    </div>

    <!-- Gütezeichen (RAL / ib) – Platzhalter, echte Logos folgen -->
    <div class="hero__badges" data-reveal="right" style="--reveal-delay: 0.3s">
      {hero.badges.map((badge) => (
        <div class="hero__badge-box" role="img" aria-label={`Platzhalter – Logo ${badge}`}>
          {badge}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    color: #fff;
    padding-block: 8rem 3.5rem;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.15) 45%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .hero__badge {
    display: inline-block;
    background: var(--color-red);
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.35rem 1rem;
    margin-bottom: 1.1rem;
  }

  .hero__title {
    font-size: clamp(1.9rem, 5.2vw, 4rem);
    color: #fff;
    max-width: 18ch;
    margin-bottom: 0.9rem;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .hero__subline {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.92);
    max-width: 52ch;
    margin-bottom: 1.75rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 2.5rem;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin: 0;
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__stat dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .hero__stat dt {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__badges {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .hero__badge-box {
    display: grid;
    place-items: center;
    width: 8rem;
    min-height: 5rem;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.92);
    border: 1px dashed #9a9a9a;
    color: var(--color-slate);
    font-size: 0.72rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.4;
  }

  @media (max-width: 56rem) {
    .hero {
      padding-top: 7rem;
    }

    .hero__content {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__badges {
      flex-direction: row;
    }

    .hero__stats {
      gap: 1.75rem;
    }
  }
</style>
