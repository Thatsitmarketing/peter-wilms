---
import { hero, stats } from '../../data/site';
---

<section class="hero photo-placeholder" aria-label="Einführung">
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="photo-placeholder__tag">
    <span>Bild-Platzhalter: Baustellenfoto (Vollbild-Hintergrund)</span>
  </div>

  <div class="container hero__content">
    <div class="hero__main">
      <p class="hero__badge" data-reveal>{hero.badge}</p>
      <h1 class="hero__title" data-reveal style="--reveal-delay: 0.08s">{hero.title}</h1>
      <p class="hero__subline" data-reveal style="--reveal-delay: 0.16s">{hero.subline}</p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 0.24s">
        <a href={hero.ctaPrimary.href} class="btn btn--red">{hero.ctaPrimary.label}</a>
        <a href={hero.ctaSecondary.href} class="btn btn--white">{hero.ctaSecondary.label}</a>
      </div>

      <dl class="hero__stats" data-reveal style="--reveal-delay: 0.32s">
        {stats.map((stat) => (
          <div class="hero__stat">
            <dd>
              <span data-counter data-target={stat.value}>0</span>{stat.suffix}
            </dd>
            <dt>{stat.label}</dt>
          </div>
        ))}
      </dl>

      <!-- Auszeichnungen: Google-Rating (verlinkt) + RAL Gütezeichen –
           bewusst unter dem Hauptinhalt, damit sie zentral-links stehen
           statt am rechten Bildrand zu kleben. -->
      <aside class="hero__awards" data-reveal style="--reveal-delay: 0.4s" aria-label="Auszeichnungen und Zertifikate">
        <a
          class="award-card award-card--rating"
          href="https://share.google/xpGrdheobczk3NP0K"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google-Bewertung Peter Willms Bauunternehmung öffnen"
        >
          <p class="award-card__eyebrow">Bestbewerteter</p>
          <p class="award-card__eyebrow award-card__eyebrow--strong">Service 2026</p>
          <div class="award-card__google" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
          </div>
          <p class="award-card__rating">
            <span class="award-card__score">4.6</span>
            <span class="award-card__stars" aria-label="4,6 von 5 Sternen">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="#f5b400"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.88-5-4.87 6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="#f5b400"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.88-5-4.87 6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="#f5b400"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.88-5-4.87 6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="#f5b400"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.88-5-4.87 6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="#f5b400"><defs><linearGradient id="halfStar"><stop offset="60%" stop-color="#f5b400"/><stop offset="60%" stop-color="#e2e2e2"/></linearGradient></defs><path fill="url(#halfStar)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.88-5-4.87 6.91-1.01L12 2z"/></svg>
            </span>
          </p>
          <p class="award-card__verified">verifiziert von: Google</p>
        </a>

        <div class="award-card award-card--ral" aria-label="RAL Gütezeichen">
          <svg class="award-card__ral-svg" viewBox="0 0 120 150" role="img" aria-hidden="true">
            <!-- Äußerer und innerer orangefarbener Rahmen -->
            <rect x="3" y="3" width="114" height="144" fill="#fff" stroke="#e07b1a" stroke-width="6" />
            <rect x="14" y="14" width="92" height="122" fill="#fff" stroke="#e07b1a" stroke-width="2.5" />
            <!-- Wortmarke RAL -->
            <text
              x="60" y="76"
              text-anchor="middle"
              font-family="Georgia, 'Times New Roman', serif"
              font-weight="700"
              font-size="38"
              fill="#1f1f1f"
              letter-spacing="1"
            >RAL</text>
            <!-- Trennlinie -->
            <line x1="26" y1="92" x2="94" y2="92" stroke="#e07b1a" stroke-width="1.4" />
            <!-- Untertitel GÜTEZEICHEN -->
            <text
              x="60" y="112"
              text-anchor="middle"
              font-family="Arial, Helvetica, sans-serif"
              font-weight="700"
              font-size="11"
              fill="#1f1f1f"
              letter-spacing="2"
            >GÜTEZEICHEN</text>
          </svg>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    /* Inhalt vertikal zentriert – Content verteilt sich gleichmäßig
       über die Bildschirmhöhe statt am unteren Rand zu kleben. */
    align-items: center;
    color: #fff;
    padding-block: clamp(6rem, 12vh, 9rem) clamp(3rem, 6vh, 4.5rem);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.2) 45%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    /* Ein einziger Content-Block – Awards liegen jetzt unter den Stats
       und stehen dadurch zentral-links im Hero statt am rechten Rand. */
    display: block;
  }

  .hero__main {
    min-width: 0;
    max-width: none;
  }

  .hero__badge {
    display: inline-block;
    background: var(--color-red);
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.35rem 1rem;
    margin-bottom: 1.1rem;
  }

  .hero__title {
    font-size: clamp(1.9rem, 5.2vw, 4rem);
    color: #fff;
    max-width: 22ch;
    margin-bottom: 1rem;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .hero__subline {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.92);
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 2.75rem;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 4.5vw, 4rem);
    margin: 0;
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero__stat dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .hero__stat dt {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
  }

  /* ---------- Auszeichnungen ---------- */

  .hero__awards {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    flex-shrink: 0;
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
  }

  .award-card {
    background: #fff;
    color: var(--color-ink);
    padding: 0.7rem 0.75rem;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.25;
    text-decoration: none;
  }

  a.award-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  a.award-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.22);
  }

  .award-card--rating {
    width: 9.5rem;
    min-height: 11rem;
    gap: 0.15rem;
  }

  .award-card__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    color: #222;
  }

  .award-card__eyebrow--strong {
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .award-card__google {
    margin: 0.25rem 0;
  }

  .award-card__rating {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
    font-weight: 600;
  }

  .award-card__score {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: #222;
  }

  .award-card__stars {
    display: inline-flex;
    gap: 0.05rem;
  }

  .award-card__verified {
    margin: 0.35rem 0 0;
    font-size: 0.6rem;
    color: #6a6a6a;
    letter-spacing: 0.02em;
  }

  /* RAL Gütezeichen – SVG-basierte Marke */
  .award-card--ral {
    width: 8rem;
    padding: 0.4rem;
    background: #fff;
    justify-content: center;
  }

  .award-card__ral-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 62rem) {
    .hero__awards {
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }

  @media (max-width: 40rem) {
    .award-card--rating {
      width: 8.5rem;
      min-height: 10rem;
    }

    .award-card--ral {
      width: 7rem;
    }
  }
</style>
