---
import MediaPlaceholder from '../MediaPlaceholder.astro';
import { contacts } from '../../data/site';
---

<section class="section section--soft" id="ansprechpartner" aria-labelledby="team-title">
  <div class="container">
    <span class="section__kicker" data-reveal>Ansprechpartner</span>
    <h2 class="section__title" id="team-title" data-reveal>
      Kurze Wege, direkte Ansprechpartner
    </h2>
    <p class="section__intro" data-reveal>
      Bei uns sprechen Sie nicht mit einer Hotline, sondern direkt mit den Menschen,
      die Ihr Projekt verantworten.
    </p>

    <div class="team__grid">
      {contacts.map((person, index) => (
        <!-- Reveal auf dem Wrapper, Hover-Transition auf der Karte -->
        <div data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
          <article class="team-card">
            <div class="team-card__photo">
              <MediaPlaceholder label={`Porträt ${person.name}`} ratio="1/1" />
            </div>
            <div class="team-card__body">
              <h3 class="team-card__name">{person.name}</h3>
              <p class="team-card__role">{person.role}</p>
              <a class="team-card__phone" href={`tel:${person.phoneLink.replace(/\s/g, '')}`}>
                {person.phone}
              </a>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 24rem));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .team-card {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .team-card__photo {
    width: 5.5rem;
    flex-shrink: 0;
  }

  .team-card__photo :global(.media-placeholder) {
    border-radius: 50%;
    padding: 0.5rem;
  }

  .team-card__photo :global(.media-placeholder__label) {
    display: none;
  }

  .team-card__name {
    font-size: 1.05rem;
    margin-bottom: 0.15rem;
  }

  .team-card__role {
    font-size: 0.88rem;
    color: var(--color-slate);
    margin-bottom: 0.5rem;
  }

  .team-card__phone {
    font-weight: 600;
    text-decoration: none;
    color: var(--color-accent-dark);
  }

  .team-card__phone:hover {
    text-decoration: underline;
  }
</style>
