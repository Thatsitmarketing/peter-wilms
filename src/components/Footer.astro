---
import { brandLogo, company, footerNav } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__col">
      <a href="/" class="footer__brand" aria-label="Peter Willms Bauunternehmung – Startseite">
        <img
          class="footer__logo"
          src={brandLogo.white}
          alt={brandLogo.alt}
          width="1024"
          height="800"
          loading="lazy"
        />
      </a>
    </div>

    <div class="footer__col">
      <address class="footer__address">
        <strong>{company.name}</strong><br />
        <a href={company.address.mapsUrl} target="_blank" rel="noopener noreferrer">
          {company.address.street}<br />
          {company.address.zip} {company.address.city}
        </a><br />
        <a href={`tel:${company.contact.phoneCentral.replace(/\s/g, '')}`}>
          {company.contact.phoneCentralDisplay}
        </a><br />
        <a href={`mailto:${company.contact.email}`}>{company.contact.email}</a>
      </address>
    </div>

    <div class="footer__col">
      <p class="footer__heading">Leistungen</p>
      <ul class="footer__list">
        {footerNav.leistungen.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <p class="footer__heading">Rechtliches</p>
      <ul class="footer__list">
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
        <li>
          <!-- Öffnet den Consent-Dialog erneut (DSGVO: jederzeit anpassbar) -->
          <button type="button" class="footer__consent-btn" data-open-consent>
            Cookie-Einstellungen
          </button>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {year} {company.name}. Alle Rechte vorbehalten.</p>
      <div class="footer__social">
        <!-- Platzhalter-Links: echte Profile eintragen oder Icons entfernen -->
        <a href="#" aria-label="Facebook (Link folgt)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.3-.04-1.3-.12-2.45-.12-2.4 0-4.05 1.45-4.05 4.15v2.32H7.5V13h2.7v8h3.3z" />
          </svg>
        </a>
        <a href="#" aria-label="Instagram (Link folgt)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-black);
    color: #cfcfcf;
    font-size: 0.95rem;
  }

  .footer a,
  .footer__consent-btn {
    color: #ececec;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer a:hover,
  .footer__consent-btn:hover {
    color: var(--color-red);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2.5rem;
    padding-block: 4rem 3rem;
  }

  .footer__brand {
    display: inline-block;
  }

  .footer__logo {
    width: clamp(11rem, 16vw, 14rem);
    height: auto;
  }

  .footer__address {
    font-style: normal;
    line-height: 1.9;
  }

  .footer__address strong {
    color: #fff;
  }

  /* Rote Spaltenüberschriften wie in der Referenz */
  .footer__heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-red);
    margin-bottom: 1.1rem;
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer__consent-btn {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .footer__bottom {
    border-top: 1px solid #262626;
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.4rem;
    font-size: 0.85rem;
    color: #9a9a9a;
  }

  .footer__bottom-inner p {
    margin: 0;
  }

  .footer__social {
    display: flex;
    gap: 1.1rem;
  }
</style>
